NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,62}$")
MAC_RE = re.compile(r"^(?:[0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$")


class KVMError(RuntimeError):
    pass


def eprint(*args: Any) -> None:
    print(*args, file=sys.stderr)


def run(cmd: List[str], *, check: bool = True, capture: bool = False, input_text: Optional[str] = None) -> subprocess.CompletedProcess:
    env = os.environ.copy()
    env["LC_ALL"] = "C"
    if capture:
        return subprocess.run(cmd, check=check, text=True, input=input_text, stdout=subprocess.PIPE, stderr=subprocess.PIPE, env=env)
    return subprocess.run(cmd, check=check, text=True, input=input_text, env=env)


def output(cmd: List[str], *, check: bool = True) -> str:
    p = run(cmd, check=check, capture=True)
    return p.stdout.strip()


def require_commands(names: List[str]) -> None:
    missing = [x for x in names if shutil.which(x) is None]
    if missing:
        raise KVMError("Missing required command(s): " + ", ".join(missing))


CLOUD_SEED_COMMANDS = ("cloud-localds", "genisoimage", "mkisofs", "xorrisofs", "xorriso")


def find_cloud_seed_generator() -> Optional[str]:
    for cmd in CLOUD_SEED_COMMANDS:
        if shutil.which(cmd):
            return cmd
    return None


def require_cloud_seed_generator() -> str:
    tool = find_cloud_seed_generator()
    if not tool:
        raise KVMError(
            "Missing cloud-init ISO generator: install cloud-localds (cloud-image-utils / cloud-utils), "
            "genisoimage, mkisofs, or xorriso"
        )
    return tool


def ensure_dirs() -> None:
    for p in (BASE_DIR, VM_DIR, STATE_DIR, CLOUD_DIR, DEF_DIR):
        p.mkdir(parents=True, exist_ok=True)


def domain_exists(name: str) -> bool:
    p = run(["virsh", "-c", LIBVIRT_URI, "dominfo", name], check=False, capture=True)
    return p.returncode == 0


def domain_state(name: str) -> str:
    p = run(["virsh", "-c", LIBVIRT_URI, "domstate", name], check=False, capture=True)
    return p.stdout.strip() if p.returncode == 0 else "unknown"


def is_running_state(state: str) -> bool:
    s = state.lower()
    return s not in {"shut off", "shutoff", "crashed", "no state", "unknown"}


def virsh_names() -> List[str]:
    text = output(["virsh", "-c", LIBVIRT_URI, "list", "--all", "--name"])
    return [x.strip() for x in text.splitlines() if x.strip()]


def existing_macs() -> set[str]:
    """Collect MAC addresses already assigned to libvirt domains."""
    macs: set[str] = set()
    for name in virsh_names():
        p = run(["virsh", "-c", LIBVIRT_URI, "domiflist", name], check=False, capture=True)
        if p.returncode != 0:
            continue
        for line in p.stdout.splitlines():
            cols = line.split()
            if len(cols) >= 5 and MAC_RE.match(cols[-1]):
                macs.add(cols[-1].lower())
    return macs


def generate_mac(*, exclude: Optional[set[str]] = None) -> str:
    # QEMU/libvirt OUI; locally generated unicast MAC.
    for _ in range(200):
        mac = "52:54:00:%02x:%02x:%02x" % (random.randrange(256), random.randrange(256), random.randrange(256))
        if exclude is None or mac.lower() not in exclude:
            return mac
    raise KVMError("Could not generate a unique MAC address after 200 attempts")


def yaml_load(path: Path) -> Dict[str, Any]:
    try:
        data = yaml.safe_load(path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        raise KVMError(f"Definition not found: {path}") from None
    except yaml.YAMLError as exc:
        raise KVMError(f"Invalid YAML {path}: {exc}") from exc
    if not isinstance(data, dict):
        raise KVMError("YAML root must be a mapping")
    return data


def yaml_dump(path: Path, data: Dict[str, Any]) -> None:
    path.write_text(yaml.safe_dump(data, sort_keys=False, allow_unicode=True), encoding="utf-8")


def dig(d: Dict[str, Any], *keys: str, default: Any = None) -> Any:
    cur: Any = d
    for key in keys:
        if not isinstance(cur, dict) or key not in cur:
            return default
        cur = cur[key]
    return cur


def normalize_definition(raw: Dict[str, Any], *, for_clone: bool = False) -> Dict[str, Any]:
    version = raw.get("version", 1)
    if version != 1:
        raise KVMError(f"Unsupported definition version: {version}")

    vm = raw.get("vm") or {}
    storage = raw.get("storage") or {}
    network = raw.get("network") or {}
    ci = raw.get("cloud_init") or {}
    image = storage.get("image") or {}

    env_name = os.environ.get("KVM_VM_NAME")
    name = env_name if env_name is not None else vm.get("name")
    if not isinstance(name, str) or not NAME_RE.match(name):
        raise KVMError("vm.name is required and must match [A-Za-z0-9][A-Za-z0-9._-]{0,62}")

    env_vcpus = os.environ.get("KVM_VM_VCPUS")
    if env_vcpus is not None:
        try:
            vcpus = int(env_vcpus)
        except ValueError as exc:
            raise KVMError(f"Invalid KVM_VM_VCPUS: {env_vcpus}") from exc
    else:
        vcpus = int(vm.get("vcpus", 2))
    if not (1 <= vcpus <= 1024):
        raise KVMError("vm.vcpus must be between 1 and 1024")

    env_mem = os.environ.get("KVM_VM_MEMORY") or os.environ.get("KVM_VM_MEMORY_MIB")
    if env_mem is not None:
        try:
            memory_mib = int(env_mem)
        except ValueError as exc:
            raise KVMError(f"Invalid KVM_VM_MEMORY: {env_mem}") from exc
    else:
        memory_mib = int(vm.get("memory_mib", 2048))
    if memory_mib < 256:
        raise KVMError("vm.memory_mib must be >= 256")

    env_disk = os.environ.get("KVM_VM_DISK") or os.environ.get("KVM_VM_DISK_GIB")
    if env_disk is not None:
        try:
            disk_gib = int(env_disk)
        except ValueError as exc:
            raise KVMError(f"Invalid KVM_VM_DISK: {env_disk}") from exc
    else:
        disk_gib = storage.get("disk_gib")
        if disk_gib is not None:
            disk_gib = int(disk_gib)
        elif not for_clone:
            disk_gib = 20

    if disk_gib is not None and disk_gib < 1:
        raise KVMError("storage.disk_gib must be >= 1")

    env_os = os.environ.get("KVM_VM_OS")
    distro = image.get("distro")
    url = image.get("url")
    local_path = image.get("path")
    if env_os:
        if not for_clone:
            if env_os in DISTROS:
                distro = env_os
                url = None
                local_path = None
            else:
                raise KVMError(f"Unsupported KVM_VM_OS '{env_os}'. Supported: {', '.join(sorted(DISTROS))}")
        os_variant_val = env_os
    else:
        os_variant_val = vm.get("os_variant")

    if not for_clone:
        selected = sum(bool(x) for x in (distro, url, local_path))
        if selected != 1:
            raise KVMError("For create, storage.image must specify exactly one of distro, url, or path")
        if distro and distro not in DISTROS:
            raise KVMError(f"Unsupported distro '{distro}'. Supported: {', '.join(sorted(DISTROS))}")

    env_bridge = os.environ.get("KVM_VM_BRIDGE")
    env_macvtap = os.environ.get("KVM_VM_MACVTAP")
    network_mode = str(network.get("mode", "bridge")).lower()
    if env_bridge is not None and (env_macvtap is not None or network_mode == "macvtap"):
        raise KVMError("KVM_VM_BRIDGE conflicts with Macvtap; unset the conflicting override")
    if env_bridge is not None:
        network_mode = "bridge"
        bridge = env_bridge
    else:
        bridge = network.get("bridge")
        if bridge is None:
            bridge = DEFAULT_BRIDGE

    if env_macvtap is not None:
        network_mode = "macvtap"

    if network_mode not in {"bridge", "nat", "macvtap"}:
        raise KVMError("network.mode must be bridge or nat or macvtap")

    libvirt_network = network.get("libvirt_network", "default")
    parent = env_macvtap if env_macvtap is not None else network.get("parent")
    if network_mode == "bridge":
        if not isinstance(bridge, str) or not bridge.strip():
            raise KVMError("network.bridge must be a non-empty bridge/interface name")
    elif network_mode == "nat":
        if not isinstance(libvirt_network, str) or not libvirt_network.strip():
            raise KVMError("network.libvirt_network must be a non-empty libvirt network name")
    elif not isinstance(parent, str) or not re.fullmatch(r"[A-Za-z0-9_.-]{1,15}", parent):
        raise KVMError("network.parent must be a non-empty Ethernet interface name (up to 15 characters)")

    model = network.get("model", "virtio")
    mac = network.get("mac") or "auto"
    if mac != "auto" and not MAC_RE.match(str(mac)):
        raise KVMError("network.mac must be 'auto' or a MAC address")

    env_ipv4 = os.environ.get("KVM_VM_IPV4")
    env_gw = os.environ.get("KVM_VM_GATEWAY")
    env_dns = os.environ.get("KVM_VM_DNS")

    ipv4 = dict(network.get("ipv4") or {"method": "dhcp"})
    if env_ipv4:
        env_ipv4_val = env_ipv4.strip()
        env_ipv4_lower = env_ipv4_val.lower()
        if env_ipv4_lower in {"dhcp", "disabled"}:
            ipv4["method"] = env_ipv4_lower
            ipv4.pop("address", None)
        elif "/" in env_ipv4_val:
            ipv4["method"] = "static"
            ipv4["address"] = env_ipv4_val
        else:
            raise KVMError("KVM_VM_IPV4 must be 'dhcp', 'disabled', or an IP interface with CIDR prefix (e.g. 192.168.10.50/24)")

    if env_gw:
        ipv4["gateway"] = env_gw.strip()
    if env_dns:
        ipv4["dns"] = [d.strip() for d in env_dns.split(",") if d.strip()]

    method = ipv4.get("method", "dhcp")
    if method not in {"dhcp", "static", "disabled"}:
        raise KVMError("network.ipv4.method must be dhcp, static, or disabled")
    if method == "static":
        address = ipv4.get("address")
        gateway = ipv4.get("gateway")
        if not address or not gateway:
            raise KVMError("Static IPv4 requires network.ipv4.address and gateway")
        try:
            ipaddress.ip_interface(address)
            ipaddress.ip_address(gateway)
            for dns in ipv4.get("dns", []):
                ipaddress.ip_address(dns)
        except ValueError as exc:
            raise KVMError(f"Invalid IPv4 configuration: {exc}") from exc

    user = ci.get("user", "admin")
    if not re.match(r"^[a-z_][a-z0-9_-]*[$]?$", user):
        raise KVMError(f"Invalid cloud_init.user: {user}")
    console_password = ci.get("console_password", False)
    if type(console_password) is not bool:
        raise KVMError("cloud_init.console_password must be a boolean")
    if console_password and user == "root":
        raise KVMError("Console password login requires a non-root management user")

    ssh_port = ci.get("ssh_port", 22)
    if type(ssh_port) is not int or not 1 <= ssh_port <= 65535:
        raise KVMError("cloud_init.ssh_port must be an integer between 1 and 65535")

    keys = ci.get("ssh_authorized_keys", [])
    if not isinstance(keys, list):
        raise KVMError("cloud_init.ssh_authorized_keys must be a list")
    if not keys:
        raise KVMError("cloud_init.ssh_authorized_keys must contain at least one key (use file:/path/to/key.pub or a literal public key)")

    packages = ci.get("packages", [])
    if not isinstance(packages, list):
        raise KVMError("cloud_init.packages must be a list")

    runcmd = ci.get("runcmd", [])
    if not isinstance(runcmd, list):
        raise KVMError("cloud_init.runcmd must be a list")

    effective: Dict[str, Any] = {
        "version": 1,
        "vm": {
            "name": name,
            "vcpus": vcpus,
            "memory_mib": memory_mib,
            "cpu": vm.get("cpu", "host-passthrough"),
            "autostart": bool(vm.get("autostart", True)),
            "start": bool(vm.get("start", True)),
            "os_variant": os_variant_val,
        },
        "storage": {
            "disk_gib": disk_gib,
            "bus": storage.get("bus", "virtio"),
            "cache": storage.get("cache", "none"),
            "discard": storage.get("discard", "unmap"),
            "image": {
                "distro": distro,
                "url": url,
                "path": local_path,
                "sha256": image.get("sha256"),
            },
        },
        "network": {
            "mode": network_mode,
            **({"bridge": bridge} if network_mode == "bridge" else
               {"parent": parent} if network_mode == "macvtap" else
               {"libvirt_network": libvirt_network}),
            "model": model,
            "mac": mac,
            "ipv4": ipv4,
            "ipv6": network.get("ipv6", {"method": "disabled"}),
        },
        "cloud_init": {
            "user": user,
            "console_password": console_password,
            "ssh_port": ssh_port,
            "ssh_authorized_keys": keys,
            "package_update": bool(ci.get("package_update", False)),
            "qemu_guest_agent": bool(ci.get("qemu_guest_agent", True)),
            "packages": packages,
            "timezone": ci.get("timezone"),
            "runcmd": runcmd,
        },
    }
    return effective


def resolve_file_path(path_str: str, definition_dir: Optional[Path] = None) -> Path:
    """Resolve a file path string.

    Supports:
    - '~/' or '~': current user's home directory. If running under sudo,
      automatically resolves to $SUDO_USER's home directory.
    - '~username/...': specified user's home directory.
    - Relative paths: resolved relative to definition_dir (if provided).
    - Absolute paths: used as-is.
    """
    raw = path_str.strip()
    if raw.startswith("~"):
        sudo_user = os.environ.get("SUDO_USER")
        if sudo_user and (raw == "~" or raw.startswith("~/") or raw.startswith("~\\")):
            user_home: Optional[Path] = None
            if pwd is not None:
                try:
                    user_home = Path(pwd.getpwnam(sudo_user).pw_dir)
                except (KeyError, TypeError):
                    pass
            if user_home is None:
                expanded = os.path.expanduser(f"~{sudo_user}")
                if not expanded.startswith("~"):
                    user_home = Path(expanded)
                elif Path(f"/home/{sudo_user}").is_dir():
                    user_home = Path(f"/home/{sudo_user}")
            if user_home is not None:
                if raw == "~":
                    return user_home
                rel = raw[2:]
                return user_home / rel
        return Path(raw).expanduser()

    p = Path(raw)
    if not p.is_absolute() and definition_dir is not None:
        p = definition_dir / p
    return p


def resolve_ssh_keys(items: List[Any], definition_dir: Path) -> List[str]:
    result: List[str] = []
    for item in items:
        if not isinstance(item, str):
            raise KVMError("Each ssh_authorized_keys entry must be a string")
        if item.startswith("file:"):
            p = resolve_file_path(item[5:], definition_dir)
            try:
                lines = [x.strip() for x in p.read_text(encoding="utf-8").splitlines() if x.strip() and not x.lstrip().startswith("#")]
            except FileNotFoundError:
                raise KVMError(f"SSH public key file not found: {p}") from None
            except PermissionError as exc:
                raise KVMError(f"Permission denied reading SSH public key file: {p}") from exc
            result.extend(lines)
        else:
            result.append(item.strip())
    for key in result:
        if not (key.startswith("ssh-") or key.startswith("ecdsa-") or key.startswith("sk-")):
            raise KVMError(f"SSH key does not look like an OpenSSH public key: {key[:30]}...")
    return result


def validate_bridge(bridge: str) -> None:
    # A libvirt bridge may exist even if /sys/class/net isn't visible in unusual namespaces,
    # so only fail when ip is available and explicitly says it is missing.
    if shutil.which("ip"):
        p = run(["ip", "link", "show", "dev", bridge], check=False, capture=True)
        if p.returncode != 0:
            raise KVMError(f"Bridge/interface not found: {bridge}")


def validate_nat_network(network_name: str) -> None:
    info = run(["virsh", "-c", LIBVIRT_URI, "net-info", network_name], check=False, capture=True)
    if info.returncode != 0:
        raise KVMError(f"Libvirt NAT network not found: {network_name}")

    values: Dict[str, str] = {}
    for line in info.stdout.splitlines():
        if ":" in line:
            key, value = line.split(":", 1)
            values[key.strip().lower()] = value.strip().lower()
    if values.get("active") != "yes":
        raise KVMError(
            f"Libvirt NAT network '{network_name}' is not active; start it with: "
            f"virsh -c {LIBVIRT_URI} net-start {network_name}"
        )

    xml = run(["virsh", "-c", LIBVIRT_URI, "net-dumpxml", network_name], check=False, capture=True)
    if xml.returncode != 0:
        raise KVMError(f"Could not inspect libvirt network: {network_name}")
    try:
        root = ET.fromstring(xml.stdout)
    except ET.ParseError as exc:
        raise KVMError(f"Invalid libvirt network XML for '{network_name}': {exc}") from exc
    forward = root.find("forward")
    if forward is None:
        raise KVMError(f"Libvirt network '{network_name}' is isolated, not NAT")
    mode = forward.attrib.get("mode", "nat").lower()
    if mode != "nat":
        raise KVMError(f"Libvirt network '{network_name}' uses forward mode '{mode}', not NAT")


def validate_macvtap_parent(parent: str) -> None:
    require_commands(["ip"])
    result = run(["ip", "-j", "-d", "link", "show", "dev", parent], check=False, capture=True)
    try:
        links = json.loads(result.stdout)
        if result.returncode or not isinstance(links, list) or len(links) != 1:
            raise ValueError("missing interface")
        link = links[0]
        if not isinstance(link, dict) or link.get("ifname") != parent:
            raise ValueError("unexpected interface")
        info = link.get("linkinfo", {})
        if not isinstance(info, dict):
            raise ValueError("invalid link information")
    except (ValueError, TypeError) as exc:
        raise KVMError(f"Could not inspect Macvtap parent {parent}; check iproute2 and the interface") from exc
    sysnet = NET_SYS_DIR / parent
    if (link.get("link_type") != "ether" or info.get("info_kind") or link.get("master")
            or not (sysnet / "device").exists() or (sysnet / "wireless").exists()
            or (sysnet / "phy80211").exists()):
        raise KVMError(f"Macvtap parent {parent} must be a standalone physical wired Ethernet interface")
    if "UP" not in link.get("flags", []):
        raise KVMError(f"Macvtap parent {parent} is down; configure it before creating a VM")


def validate_network_attachment(net: Dict[str, Any]) -> None:
    if net["mode"] == "bridge":
        validate_bridge(net["bridge"])
    elif net["mode"] == "nat":
        validate_nat_network(net["libvirt_network"])
    elif net["mode"] == "macvtap":
        validate_macvtap_parent(net["parent"])
    else:
        raise KVMError(f"Unsupported network mode: {net['mode']}")


def sha256_file(path: Path) -> str:
    h = hashlib.sha256()
    with path.open("rb") as f:
        for chunk in iter(lambda: f.read(8 * 1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()


def download(url: str, dst: Path, *, retries: int = 2, timeout: int = 30) -> None:
    tmp = dst.with_suffix(dst.suffix + ".part")
    if tmp.exists():
        tmp.unlink()
    print(f"Downloading {url}\n       -> {dst}")
    req = urllib.request.Request(url, headers={"User-Agent": f"kvm-vm/{VERSION}"})
    last_exc: Optional[Exception] = None
    for attempt in range(1, retries + 1):
        try:
            with urllib.request.urlopen(req, timeout=timeout) as r, tmp.open("wb") as f:
                total = int(r.headers.get("Content-Length", "0") or 0)
                done = 0
                while True:
                    buf = r.read(8 * 1024 * 1024)
                    if not buf:
                        break
                    f.write(buf)
                    done += len(buf)
                    if total:
                        print(f"\r  {done * 100 // total:3d}% ({done // (1024*1024)} MiB / {total // (1024*1024)} MiB)", end="", flush=True)
                if total:
                    print()
            tmp.replace(dst)
            return
        except (urllib.error.URLError, OSError) as exc:
            last_exc = exc
            if tmp.exists():
                tmp.unlink()
            if attempt < retries:
                log.warning(f"Download attempt {attempt}/{retries} failed: {exc}; retrying ...")
    raise KVMError(f"Download failed after {retries} attempt(s): {last_exc}") from last_exc


def acquire_base_image(cfg: Dict[str, Any], refresh: bool) -> Tuple[Path, Optional[str]]:
    image = cfg["storage"]["image"]
    distro = image.get("distro")
    url = image.get("url")
    local_path = image.get("path")
    expected_sha = image.get("sha256")
    default_variant: Optional[str] = None

    if distro:
        meta = DISTROS[distro]
        url = meta["url"]
        cache_path = BASE_DIR / meta["cache"]
        default_variant = meta["os_variant"]
    elif url:
        name = Path(urlparse(url).path).name
        if not name:
            name = hashlib.sha256(url.encode()).hexdigest()[:16] + ".qcow2"
        cache_path = BASE_DIR / name
    else:
        p = resolve_file_path(str(local_path)).resolve()
        if not p.is_file():
            raise KVMError(f"Base image not found: {p}")
        if expected_sha and sha256_file(p).lower() != str(expected_sha).lower():
            raise KVMError(f"SHA256 mismatch for {p}")
        qemu_img_info(p)
        return p, default_variant

    if refresh or not cache_path.exists():
        download(str(url), cache_path)
    if expected_sha and sha256_file(cache_path).lower() != str(expected_sha).lower():
        raise KVMError(f"SHA256 mismatch for {cache_path}")
    qemu_img_info(cache_path)
    return cache_path, default_variant


def qemu_img_info(path: Path, *, shared: bool = False) -> Dict[str, Any]:
    try:
        flags = ["--force-share"] if shared else []
        info = json.loads(output(["qemu-img", "info", "--output=json"] + flags + [str(path)]))
        if not isinstance(info, dict):
            raise KVMError(f"qemu-img returned invalid image information for {path}")
        return info
    except (subprocess.CalledProcessError, json.JSONDecodeError) as exc:
        raise KVMError(f"qemu-img could not inspect {path}: {exc}") from exc


def make_disk_from_base(base: Path, dst: Path, disk_gib: int) -> None:
    if dst.exists():
        raise KVMError(f"Target disk already exists: {dst}")
    info = qemu_img_info(base)
    min_bytes = int(info.get("virtual-size", 0))
    target_bytes = disk_gib * 1024**3
    if min_bytes and target_bytes < min_bytes:
        raise KVMError(f"Requested disk {disk_gib} GiB is smaller than base image virtual size {min_bytes / 1024**3:.1f} GiB")
    tmp = dst.with_suffix(dst.suffix + ".tmp")
    try:
        run(["qemu-img", "convert", "-p", "-f", str(info.get("format", "qcow2")), "-O", "qcow2", str(base), str(tmp)])
        if target_bytes > int(qemu_img_info(tmp).get("virtual-size", 0)):
            run(["qemu-img", "resize", str(tmp), f"{disk_gib}G"])
        tmp.replace(dst)
    finally:
        if tmp.exists():
            tmp.unlink()


def make_disk_from_clone(src: Path, dst: Path, disk_gib: Optional[int]) -> None:
    if dst.exists():
        raise KVMError(f"Target disk already exists: {dst}")
    src_info = qemu_img_info(src)
    src_virtual = int(src_info.get("virtual-size", 0))
    if disk_gib is not None and disk_gib * 1024**3 < src_virtual:
        raise KVMError(f"Clone target disk {disk_gib} GiB is smaller than source virtual size {src_virtual / 1024**3:.1f} GiB")
    tmp = dst.with_suffix(dst.suffix + ".tmp")
    try:
        run(["qemu-img", "convert", "-p", "-f", str(src_info.get("format", "qcow2")), "-O", "qcow2", str(src), str(tmp)])
        if disk_gib is not None and disk_gib * 1024**3 > int(qemu_img_info(tmp).get("virtual-size", 0)):
            run(["qemu-img", "resize", str(tmp), f"{disk_gib}G"])
        tmp.replace(dst)
    finally:
        if tmp.exists():
            tmp.unlink()


def supported_sysprep_ops() -> List[str]:
    text = output(["virt-sysprep", "--list-operations"])
    ops = []
    for line in text.splitlines():
        line = line.strip()
        if line:
            ops.append(line.split()[0])
    return ops


WANTED_SYSPREP_OPS = [
    "machine-id",
    "ssh-hostkeys",
    "net-hostname",
    "net-hwaddr",
    "dhcp-client-state",
    "udev-persistent-net",
    "lvm-system-devices",
    "random-seed",
]


def selected_sysprep_ops() -> List[str]:
    available = set(supported_sysprep_ops())
    critical = {"machine-id", "ssh-hostkeys"}
    if not critical.issubset(available):
        missing = sorted(critical - available)
        raise KVMError("virt-sysprep is too old; missing critical operation(s): " + ", ".join(missing))
    return [x for x in WANTED_SYSPREP_OPS if x in available]


def verify_sysprep_compatibility(disk: Path) -> None:
    ops = selected_sysprep_ops()
    cmd = ["virt-sysprep", "--dry-run", "-a", str(disk), "--operations", ",".join(ops)]
    try:
        run(cmd, check=True, capture=True)
    except subprocess.CalledProcessError as exc:
        err = exc.stderr.strip() if exc.stderr else str(exc)
        raise KVMError(f"Source disk {disk} is not compatible with virt-sysprep: {err}") from exc


def sysprep_clone_disk(disk: Path) -> None:
    selected = selected_sysprep_ops()
    print("Sysprep operations:", ",".join(selected))
    run(["virt-sysprep", "-a", str(disk), "--operations", ",".join(selected)])

    # cloud-init clean is the supported way to make a captured instance behave like first boot.
    cleanup = (
        "if command -v cloud-init >/dev/null 2>&1; then "
        "cloud-init clean --logs; "
        "else rm -rf /var/lib/cloud/*; fi; "
        "rm -f /etc/netplan/* /etc/network/interfaces.d/*; "
        "systemd-machine-id-setup 2>/dev/null || touch /etc/machine-id"
    )
    run(["virt-customize", "-a", str(disk), "--run-command", cleanup])


def ssh_port_command(port: int) -> str:
    """Configure the guest's SSH listener after user commands and package installs.

    Update the main config for older images without sshd_config.d support too.
    Remove previous Port directives because OpenSSH allows multiple listeners,
    including when cloning a guest that used a different port. Port 22 is the
    default, so it removes kvm-vm's settings instead of writing new ones, and
    leaves a guest that has none untouched. If SSH cannot restart, restore the
    previous files so the guest stays reachable on its old port.
    """
    return f"""set -eu
port={port}
dropin=/etc/systemd/system/ssh.socket.d/zz-kvm-vm-port.conf
port_re='^[[:space:]]*[Pp][Oo][Rr][Tt]([[:space:]]|=)'
if [ "$port" = 22 ] && [ ! -e "$dropin" ] && ! grep -Eqs "$port_re" /etc/ssh/sshd_config /etc/ssh/sshd_config.d/*.conf; then
    exit 0
fi

socket=false
if systemctl is-active --quiet ssh.socket || systemctl is-enabled --quiet ssh.socket; then
    socket=true
fi

restart_ssh() {{
    if $socket; then
        systemctl daemon-reload && systemctl restart ssh.socket && systemctl try-restart ssh.service
    elif [ "$(systemctl show -p LoadState --value ssh.service)" = loaded ]; then
        systemctl restart ssh.service
    else
        systemctl restart sshd.service
    fi
}}

# set -e is ignored in a function called as a condition, so check each step.
apply_port() {{
    for config in /etc/ssh/sshd_config /etc/ssh/sshd_config.d/*.conf; do
        [ -f "$config" ] || continue
        sed -i -E "/$port_re/d" "$config" || return
    done
    if [ "$port" = 22 ]; then
        rm -f "$dropin" || return
    else
        sed -i "1iPort $port" /etc/ssh/sshd_config || return
    fi
    # Socket activation may not have started ssh.service to create its runtime dir.
    install -d -m 0755 /run/sshd || return
    /usr/sbin/sshd -t || return
    if $socket && [ "$port" != 22 ]; then
        mkdir -p /etc/systemd/system/ssh.socket.d || return
        # Ubuntu's socket uses BindIPv6Only=ipv6-only, so both addresses are needed.
        printf '[Socket]\\nListenStream=\\nListenStream=0.0.0.0:%s\\nListenStream=[::]:%s\\nBindIPv6Only=ipv6-only\\n' "$port" "$port" > "$dropin" || return
    fi
    restart_ssh
}}

backup=$(mktemp -d)
trap 'rm -rf "$backup"' EXIT
cp -p /etc/ssh/sshd_config "$backup/"
if [ -d /etc/ssh/sshd_config.d ]; then cp -pR /etc/ssh/sshd_config.d "$backup/"; fi
if [ -f "$dropin" ]; then cp -p "$dropin" "$backup/socket.conf"; fi

if ! apply_port; then
    set +e
    echo "kvm-vm: could not move SSH to port $port; restoring the previous SSH configuration" >&2
    cp -p "$backup/sshd_config" /etc/ssh/sshd_config
    if [ -d "$backup/sshd_config.d" ]; then cp -pR "$backup/sshd_config.d/." /etc/ssh/sshd_config.d/; fi
    if [ -f "$backup/socket.conf" ]; then cp -p "$backup/socket.conf" "$dropin"; else rm -f "$dropin"; fi
    restart_ssh
    exit 1
fi
"""


def deliver_console_credential(cfg: Dict[str, Any], destination: Optional[str], *, preview: bool) -> Optional[str]:
    """Validate private delivery, then deliver before any guest can use the hash."""
    if not cfg["cloud_init"].get("console_password"):
        if destination is not None:
            raise KVMError("--console-password-file requires cloud_init.console_password: true")
        return None
    if not destination:
        raise KVMError("Console password login requires --console-password-file")
    if os.name != "posix":
        raise KVMError("Console credential delivery requires POSIX permissions")
    require_commands(["openssl"])
    path = Path(os.path.abspath(os.path.expanduser(destination)))
    directory = None
    try:
        directory = os.open(path.anchor, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
        for part in path.parent.parts[1:]:
            child = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=directory)
            os.close(directory)
            directory = child
        parent = os.fstat(directory)
        if parent.st_uid != os.geteuid() or stat.S_IMODE(parent.st_mode) & 0o077:
            raise KVMError("Credential directory must be owned by the invoking administrator and private (0700)")
        try:
            os.stat(path.name, dir_fd=directory, follow_symlinks=False)
        except FileNotFoundError:
            pass
        else:
            raise KVMError("Credential destination already exists; choose a new file")
        if preview:
            return None
        password = "".join(secrets.choice("ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz23456789") for _ in range(24))
        result = run(["openssl", "passwd", "-6", "-stdin"], input_text=password + "\n", capture=True, check=False)
        password_hash = result.stdout.strip()
        if result.returncode or not re.fullmatch(r"\$6\$[./A-Za-z0-9]{1,16}\$[./A-Za-z0-9]{86}", password_hash):
            raise KVMError("Could not generate a supported console password hash")
        fd = os.open(path.name, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600, dir_fd=directory)
        with os.fdopen(fd, "w", encoding="utf-8") as output:
            os.fchmod(output.fileno(), 0o600)
            json.dump({"vm": cfg["vm"]["name"], "user": cfg["cloud_init"]["user"], "password": password}, output)
            output.write("\n")
            output.flush()
            os.fsync(output.fileno())
        os.fsync(directory)
        log.info("Console credential delivered to %s; retain it if provisioning fails", path)
        return password_hash
    except OSError:
        raise KVMError("Could not securely deliver console credential; inspect the destination before retrying") from None
    finally:
        if directory is not None:
            os.close(directory)


CONSOLE_LOGIN_SCRIPT = r"""
import datetime
import glob
from pathlib import Path
import re
import shlex
import subprocess
import sys

policy = ("PasswordAuthentication no\nKbdInteractiveAuthentication no\n"
          "ChallengeResponseAuthentication no\n")
seen = set()
def harden(path):
    path = path.resolve()
    if path in seen:
        return
    seen.add(path)
    output = []
    for line in path.read_text().splitlines(keepends=True):
        fields = shlex.split(line, comments=True)
        key = fields[0].split("=")[0].lower() if fields else ""
        if key in ("passwordauthentication", "kbdinteractiveauthentication", "challengeresponseauthentication"):
            line = key + " no\n"
        elif key == "include":
            value = re.sub(r"^\s*Include\s*=?\s*", "", line, flags=re.I)
            for pattern in shlex.split(value, comments=True):
                if not pattern.startswith("/"):
                    pattern = "/etc/ssh/" + pattern
                for included in sorted(glob.glob(pattern)):
                    harden(Path(included))
        output.append(line)
    path.write_text(policy + "".join(output))

harden(Path("/etc/ssh/sshd_config"))
subprocess.run(["/usr/sbin/sshd", "-t"], check=True)
effective = subprocess.check_output(
    ["/usr/sbin/sshd", "-T", "-C", "user=" + sys.argv[1] + ",host=localhost,addr=127.0.0.1"],
    text=True)
settings = dict(line.split(None, 1) for line in effective.splitlines() if " " in line)
assert settings.get("passwordauthentication") == "no"
assert settings.get("kbdinteractiveauthentication") == "no"
for service in ("ssh.service", "sshd.service"):
    loaded = subprocess.run(["systemctl", "show", "-p", "LoadState", "--value", service],
                            capture_output=True, text=True, check=True)
    if loaded.stdout.strip() == "loaded":
        subprocess.run(["systemctl", "try-restart", service], check=True)
subprocess.run(["systemctl", "enable", "--now", "serial-getty@ttyS0.service"], check=True)
subprocess.run(["chage", "-M", "-1", "-I", "-1", "-E", "-1",
                "-d", datetime.date.today().isoformat(), sys.argv[1]], check=True)
subprocess.run(["usermod", "-U", sys.argv[1]], check=True)
"""


def make_cloud_files(cfg: Dict[str, Any], source_def_dir: Path, *, reset_ssh_port: bool = False,
                     password_hash: Optional[str] = None) -> Tuple[Path, Path, Path, str]:
    if cfg["cloud_init"].get("console_password") and not password_hash:
        raise KVMError("Console password provisioning requires a delivered credential")
    name = cfg["vm"]["name"]
    cdir = CLOUD_DIR / name
    if cdir.exists():
        shutil.rmtree(cdir)
    cdir.mkdir(parents=True, exist_ok=True)

    if cfg["network"]["mac"] == "auto":
        cfg["network"]["mac"] = generate_mac()
    mac = cfg["network"]["mac"].lower()

    keys = resolve_ssh_keys(cfg["cloud_init"]["ssh_authorized_keys"], source_def_dir)
    user = cfg["cloud_init"]["user"]
    packages = list(cfg["cloud_init"]["packages"])
    runcmd = list(cfg["cloud_init"]["runcmd"])
    if cfg["cloud_init"]["qemu_guest_agent"]:
        if "qemu-guest-agent" not in packages:
            packages.append("qemu-guest-agent")
        runcmd.append(["systemctl", "enable", "--now", "qemu-guest-agent"])
    ssh_port = cfg["cloud_init"].get("ssh_port", 22)
    # Fresh images already listen on 22. A cloned disk may keep the source's port.
    if ssh_port != 22 or reset_ssh_port:
        runcmd.append(["sh", "-c", ssh_port_command(ssh_port)])

    user_cfg: Dict[str, Any] = {
        "hostname": name,
        "preserve_hostname": False,
        "users": [{
            "name": user,
            # Ubuntu images may already contain the admin group. Explicitly
            # reuse it, while groups ensures creation on images without it.
            "primary_group": user,
            "groups": [user],
            "lock_passwd": True,
            "sudo": "ALL=(ALL) NOPASSWD:ALL",
            "shell": "/bin/bash",
            "ssh_authorized_keys": keys,
        }],
        "ssh_pwauth": False,
        "disable_root": True,
        "package_update": cfg["cloud_init"]["package_update"],
    }
    if cfg["cloud_init"].get("console_password"):
        user_cfg["users"][0]["hashed_passwd"] = password_hash
        runcmd.append(["python3", "-c", CONSOLE_LOGIN_SCRIPT, user])
    if packages:
        user_cfg["packages"] = packages
    if cfg["cloud_init"].get("timezone"):
        user_cfg["timezone"] = cfg["cloud_init"]["timezone"]
    if runcmd:
        user_cfg["runcmd"] = runcmd

    user_data = cdir / "user-data"
    user_data.touch(mode=0o600)
    user_data.write_text("#cloud-config\n" + yaml.safe_dump(user_cfg, sort_keys=False, allow_unicode=True), encoding="utf-8")

    instance_id = "iid-" + hashlib.sha256(f"{name}-{dt.datetime.now(dt.timezone.utc).isoformat()}-{random.random()}".encode()).hexdigest()[:24]
    meta_data = cdir / "meta-data"
    meta_data.write_text(yaml.safe_dump({"instance-id": instance_id, "local-hostname": name, "dsmode": "local"}, sort_keys=False), encoding="utf-8")

    ipv4 = cfg["network"]["ipv4"]
    ipv6 = cfg["network"].get("ipv6") or {"method": "disabled"}
    eth: Dict[str, Any] = {
        "match": {"macaddress": mac},
        "set-name": "eth0",
    }
    if ipv4.get("method", "dhcp") == "dhcp":
        eth["dhcp4"] = True
    elif ipv4.get("method") == "static":
        eth["dhcp4"] = False
        eth["addresses"] = [ipv4["address"]]
        eth["routes"] = [{"to": "0.0.0.0/0", "via": ipv4["gateway"]}]
        if ipv4.get("dns"):
            eth["nameservers"] = {"addresses": ipv4["dns"]}
    else:
        eth["dhcp4"] = False

    if ipv6.get("method", "disabled") == "dhcp":
        eth["dhcp6"] = True
    elif ipv6.get("method") == "static":
        eth["dhcp6"] = False
        if ipv6.get("address"):
            eth.setdefault("addresses", []).append(ipv6["address"])
        if ipv6.get("gateway"):
            eth.setdefault("routes", []).append({"to": "::/0", "via": ipv6["gateway"]})
    else:
        eth["dhcp6"] = False

    network_data = {"version": 2, "ethernets": {"eth0": eth}}
    network_config = cdir / "network-config"
    network_config.write_text(yaml.safe_dump(network_data, sort_keys=False), encoding="utf-8")

    seed = cdir / "seed.img"
    previous_umask = os.umask(0o077)
    try:
        create_cloud_seed(seed, user_data, meta_data, network_config)
        seed.chmod(0o600)
    finally:
        os.umask(previous_umask)
    return user_data, meta_data, network_config, instance_id


def build_cloud_seed_cmd(tool: str, seed: Path, user_data: Path, meta_data: Path, network_config: Path) -> List[str]:
    if tool == "cloud-localds":
        return ["cloud-localds", "--network-config", str(network_config), str(seed), str(user_data), str(meta_data)]
    graft_args = [
        "-quiet",
        "-output", str(seed),
        "-volid", "cidata",
        "-joliet",
        "-rock",
        "-graft-points",
        f"user-data={user_data}",
        f"meta-data={meta_data}",
        f"network-config={network_config}",
    ]
    if tool in ("genisoimage", "mkisofs", "xorrisofs"):
        return [tool] + graft_args
    if tool == "xorriso":
        return ["xorriso", "-as", "mkisofs"] + graft_args
    raise KVMError(f"Unsupported cloud-init generator: {tool}")


def create_cloud_seed(seed: Path, user_data: Path, meta_data: Path, network_config: Path) -> None:
    tool = require_cloud_seed_generator()
    if seed.exists():
        seed.unlink()
    cmd = build_cloud_seed_cmd(tool, seed, user_data, meta_data, network_config)
    run(cmd)
    restore_selinux([seed])


def restore_selinux(paths: List[Path]) -> None:
    """Best-effort SELinux relabel for files under libvirt image directories."""
    if not shutil.which("restorecon"):
        return
    existing = [str(p) for p in paths if p.exists()]
    if existing:
        run(["restorecon", "-F"] + existing, check=False, capture=True)


def os_variant_available(variant: str) -> bool:
    if not variant or not shutil.which("osinfo-query"):
        return False
    p = run(["osinfo-query", "os"], check=False, capture=True)
    if p.returncode != 0:
        return False
    # Match short IDs conservatively; output format differs slightly by distro.
    return re.search(rf"(^|\s|\|){re.escape(variant)}(\s|\||$)", p.stdout, re.MULTILINE) is not None


def define_vm(cfg: Dict[str, Any], disk: Path, seed: Path, default_variant: Optional[str], *, no_start: bool = False) -> None:
    vm = cfg["vm"]
    st = cfg["storage"]
    net = cfg["network"]
    name = vm["name"]

    requested_variant = vm.get("os_variant") or default_variant or "generic"
    variant = requested_variant if requested_variant == "generic" or os_variant_available(requested_variant) else "generic"
    if variant != requested_variant:
        log.warning(f"osinfo variant '{requested_variant}' not available on this host; using 'generic'")

    disk_opts = f"path={disk},format=qcow2,bus={st['bus']},cache={st['cache']},discard={st['discard']}"
    if net["mode"] == "bridge":
        net_opts = f"bridge={net['bridge']},model={net['model']},mac={net['mac']}"
    elif net["mode"] == "macvtap":
        net_opts = f"type=direct,source={net['parent']},source.mode=bridge,model={net['model']},mac={net['mac']}"
    else:
        net_opts = f"network={net['libvirt_network']},model={net['model']},mac={net['mac']}"
    cmd = [
        "virt-install", "--connect", LIBVIRT_URI,
        "--name", name,
        "--memory", str(vm["memory_mib"]),
        "--vcpus", str(vm["vcpus"]),
        "--cpu", str(vm["cpu"]),
        "--import",
        "--disk", disk_opts,
        "--disk", f"path={seed},device=cdrom,readonly=on,format=raw",
        "--network", net_opts,
        "--os-variant", variant,
        "--graphics", "none",
        # Debian 13's GRUB (gfxterm) stalled before loading Linux without a video
        # device on an older Intel host, though not on a modern AMD host (Debian
        # bug #1111240). Keep a VGA adapter without exposing a display server.
        "--video", "vga",
        "--console", "pty,target.type=serial",
        "--noautoconsole",
    ]
    if no_start or not vm["start"]:
        cmd.append("--noreboot")
    run(cmd)

    if vm["autostart"]:
        run(["virsh", "-c", LIBVIRT_URI, "autostart", name])


def save_state(cfg: Dict[str, Any], disk: Path, source: Dict[str, Any], instance_id: str, original_def: Path) -> None:
    name = cfg["vm"]["name"]
    effective_def = DEF_DIR / f"{name}.yaml"
    yaml_dump(effective_def, cfg)
    state = {
        "version": 1,
        "managed_by": "kvm-vm",
        "name": name,
        "created_at": dt.datetime.now(dt.timezone.utc).isoformat(),
        "definition": str(effective_def),
        "definition_source": str(original_def.resolve()),
        "disk": str(disk),
        "cloud_dir": str(CLOUD_DIR / name),
        "seed": str(CLOUD_DIR / name / "seed.img"),
        "instance_id": instance_id,
        "source": source,
    }
    (STATE_DIR / f"{name}.json").write_text(json.dumps(state, indent=2) + "\n", encoding="utf-8")


def load_state(name: str) -> Optional[Dict[str, Any]]:
    p = STATE_DIR / f"{name}.json"
    if not p.exists():
        return None
    try:
        return json.loads(p.read_text(encoding="utf-8"))
    except Exception as exc:
        raise KVMError(f"Invalid state file {p}: {exc}") from exc


def report_failed_creation(name: str, disk: Path) -> None:
    # A failed external command can have defined a domain or started it. Retain
    # resources rather than guessing whether undefinition or deletion is safe.
    log.error(
        f"Creation failed for {name}; surviving domain and files were retained for manual recovery. "
        f"Inspect disk={disk}, cloud-init={CLOUD_DIR / name} and managed state before retrying."
    )


def check_new_artifacts(name: str, disk: Path) -> None:
    for path in (disk, disk.with_suffix(disk.suffix + ".tmp"), CLOUD_DIR / name):
        if path.exists() or path.is_symlink():
            raise KVMError(f"Existing artifacts at {path}; inspect and recover them before retrying {name}")


def check_create_state(name: str, disk: Path) -> None:
    state = load_state(name)
    if state is None:
        return
    # dominfo failures alone do not prove absence (e.g. libvirt is unavailable).
    domains = run(["virsh", "-c", LIBVIRT_URI, "list", "--all", "--name"], capture=True)
    if name in domains.stdout.splitlines():
        raise KVMError(f"Domain already exists: {name}")
    if not isinstance(state, dict) or state.get("managed_by") != "kvm-vm" or state.get("name") != name:
        raise KVMError(f"Invalid managed state for {name}; inspect {STATE_DIR / (name + '.json')}")
    check_new_artifacts(name, disk)
    for field in ("disk", "cloud_dir", "seed"):
        value = state.get(field)
        if not isinstance(value, str) or not value:
            raise KVMError(f"Invalid managed state field {field} for {name}")
        path = Path(value)
        paths = (path, path.with_suffix(path.suffix + ".tmp")) if field == "disk" else (path,)
        for artifact in paths:
            if artifact.exists() or artifact.is_symlink():
                raise KVMError(
                    f"Existing artifacts at {artifact}; inspect and recover them before retrying {name}"
                )
    log.warning(f"Stale managed state for {name}; it will be replaced only after successful creation")


def cmd_validate(args: argparse.Namespace) -> int:
    p = Path(args.definition)
    raw = yaml_load(p)
    cfg = normalize_definition(raw, for_clone=args.clone)
    resolve_ssh_keys(cfg["cloud_init"]["ssh_authorized_keys"], p.parent)
    print(yaml.safe_dump(cfg, sort_keys=False, allow_unicode=True))
    return 0


def lifecycle_exclusive(command):
    """Serialize local lifecycle commands sharing STATE_DIR; stale locks fail closed."""
    @functools.wraps(command)
    def invoke(args):
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        lock = STATE_DIR / ".lifecycle-lock"
        try:
            lock.mkdir()
        except FileExistsError as exc:
            raise KVMError(
                f"Another lifecycle operation or interrupted attempt owns {lock}. "
                "Check its owner and domain/storage state; remove the lock only after "
                "confirming no operation is running and recovery is complete."
            ) from exc
        try:
            (lock / "owner").write_text(f"pid={os.getpid()} command={command.__name__}\n", encoding="utf-8")
            return command(args)
        finally:
            try:
                (lock / "owner").unlink(missing_ok=True)
                lock.rmdir()
            except OSError as exc:
                log.error(f"Lifecycle lock remains at {lock}; inspect before manual removal: {exc}")
    return invoke


@lifecycle_exclusive
def cmd_create(args: argparse.Namespace) -> int:
    require_commands(["virsh", "virt-install", "qemu-img"])
    require_cloud_seed_generator()
    ensure_dirs()
    p = Path(args.definition)
    cfg = normalize_definition(yaml_load(p), for_clone=False)
    name = cfg["vm"]["name"]
    if domain_exists(name):
        raise KVMError(f"Domain already exists: {name}")
    check_create_state(name, VM_DIR / f"{name}.qcow2")
    destination = vars(args).get("console_password_file")
    deliver_console_credential(cfg, destination, preview=True)
    validate_network_attachment(cfg["network"])
    if cfg["network"]["mac"] == "auto":
        cfg["network"]["mac"] = generate_mac(exclude=existing_macs())
    resolve_ssh_keys(cfg["cloud_init"]["ssh_authorized_keys"], p.parent)

    if args.dry_run:
        print("dry-run: all pre-flight checks passed")
        print(yaml.safe_dump(cfg, sort_keys=False, allow_unicode=True))
        return 0

    base, default_variant = acquire_base_image(cfg, args.refresh_image)
    disk = VM_DIR / f"{name}.qcow2"
    check_new_artifacts(name, disk)
    password_hash = deliver_console_credential(cfg, destination, preview=False)
    try:
        make_disk_from_base(base, disk, int(cfg["storage"]["disk_gib"]))
        restore_selinux([disk])
        cloud_options = {"password_hash": password_hash} if password_hash else {}
        _, _, _, instance_id = make_cloud_files(cfg, p.parent, **cloud_options)
        seed = CLOUD_DIR / name / "seed.img"
        define_vm(cfg, disk, seed, default_variant, no_start=args.no_start)
        save_state(cfg, disk, {"type": "base-image", "path": str(base)}, instance_id, p)
    except Exception:
        report_failed_creation(name, disk)
        raise

    print(f"Created VM: {name}")
    print(f"Definition: {DEF_DIR / (name + '.yaml')}")
    print(f"Disk:       {disk}")
    if not args.no_start and cfg["vm"]["start"]:
        print(f"Console:    kvm-vm console {name}")
    return 0


def first_disk_source(name: str) -> Path:
    p = run(["virsh", "-c", LIBVIRT_URI, "domblklist", name, "--details"], capture=True)
    for line in p.stdout.splitlines():
        cols = line.split()
        if len(cols) >= 4 and cols[0] == "file" and cols[1] == "disk" and cols[3] != "-":
            return Path(cols[3])
    raise KVMError(f"Could not find a file-backed system disk for {name}")


@lifecycle_exclusive
def cmd_clone(args: argparse.Namespace) -> int:
    require_commands(["virsh", "virt-install", "qemu-img", "virt-sysprep", "virt-customize"])
    require_cloud_seed_generator()
    ensure_dirs()
    source_name = args.source
    if not domain_exists(source_name):
        raise KVMError(f"Source domain does not exist: {source_name}")
    state = domain_state(source_name)
    if is_running_state(state):
        raise KVMError(f"Source VM must be shut off before cloning (current state: {state})")
    check_recovery_metadata(source_name)
    source_state = load_state(source_name)
    src_disk = checked_domain_disk(source_name, source_state)

    p = Path(args.definition)
    cfg = normalize_definition(yaml_load(p), for_clone=True)
    source_definition = Path(source_state.get("definition") or DEF_DIR / f"{source_name}.yaml") if source_state else DEF_DIR / f"{source_name}.yaml"
    source_config = yaml_load(source_definition) if source_definition.exists() else {}
    if (cfg["cloud_init"].get("console_password")
            or source_config.get("cloud_init", {}).get("console_password")
            or vars(args).get("console_password_file") is not None):
        raise KVMError("Console password cloning is not supported yet; no guest resources changed")
    name = cfg["vm"]["name"]
    if name == source_name:
        raise KVMError("Clone target name must differ from source")
    if domain_exists(name) or load_state(name):
        raise KVMError(f"Clone target already exists or has managed state: {name}")
    validate_network_attachment(cfg["network"])
    if cfg["network"]["mac"] == "auto":
        cfg["network"]["mac"] = generate_mac(exclude=existing_macs())
    resolve_ssh_keys(cfg["cloud_init"]["ssh_authorized_keys"], p.parent)

    if not src_disk.is_file():
        raise KVMError(f"Clone currently supports regular file-backed system disks only: {src_disk}")

    verify_sysprep_compatibility(src_disk)

    if args.dry_run:
        print("dry-run: all pre-flight checks passed")
        print(yaml.safe_dump(cfg, sort_keys=False, allow_unicode=True))
        return 0

    disk = VM_DIR / f"{name}.qcow2"
    check_new_artifacts(name, disk)
    try:
        make_disk_from_clone(src_disk, disk, cfg["storage"].get("disk_gib"))
        restore_selinux([disk])
        sysprep_clone_disk(disk)
        _, _, _, instance_id = make_cloud_files(cfg, p.parent, reset_ssh_port=True)
        seed = CLOUD_DIR / name / "seed.img"
        define_vm(cfg, disk, seed, None, no_start=args.no_start)
        save_state(cfg, disk, {"type": "clone", "source_vm": source_name, "source_disk": str(src_disk)}, instance_id, p)
    except Exception:
        report_failed_creation(name, disk)
        raise

    print(f"Cloned VM: {source_name} -> {name}")
    print(f"Disk: {disk}")
    return 0


def apply_os_override(
    raw: Dict[str, Any],
    os_arg: Optional[str] = None,
    image_url: Optional[str] = None,
    image_path: Optional[str] = None,
    os_variant: Optional[str] = None,
) -> None:
    storage = raw.setdefault("storage", {})
    image = storage.setdefault("image", {})
    vm = raw.setdefault("vm", {})

    if os_arg:
        val = os_arg.strip()
        if val in DISTROS:
            image["distro"] = val
            image["url"] = None
            image["path"] = None
            image["sha256"] = None
            vm["os_variant"] = DISTROS[val]["os_variant"]
        elif val.startswith(("http://", "https://")):
            image["distro"] = None
            image["url"] = val
            image["path"] = None
            image["sha256"] = None
        elif resolve_file_path(val).is_file():
            image["distro"] = None
            image["url"] = None
            image["path"] = str(resolve_file_path(val).resolve())
            image["sha256"] = None
        elif "/" in val or "\\" in val or val.endswith((".qcow2", ".img", ".raw")):
            p = resolve_file_path(val).resolve()
            if not p.is_file():
                raise KVMError(f"Base image not found: {val}")
            image["distro"] = None
            image["url"] = None
            image["path"] = str(p)
            image["sha256"] = None
        else:
            distro_list = ", ".join(sorted(DISTROS))
            raise KVMError(f"Unsupported OS or distro '{val}'. Supported distros: {distro_list}")
    elif image_url:
        image["distro"] = None
        image["url"] = image_url.strip()
        image["path"] = None
        image["sha256"] = None
    elif image_path:
        p = resolve_file_path(image_path).resolve()
        if not p.is_file():
            raise KVMError(f"Base image not found: {p}")
        image["distro"] = None
        image["url"] = None
        image["path"] = str(p)
        image["sha256"] = None

    if os_variant:
        vm["os_variant"] = os_variant.strip()


def confirm_reinstall(name: str, yes: bool) -> None:
    if yes:
        return
    if not sys.stdin.isatty():
        raise KVMError("Refusing destructive reinstall without --yes in non-interactive mode")
    ans = input(f"Reinstall VM '{name}'? Type the VM name to confirm: ")
    if ans != name:
        raise KVMError("Reinstall cancelled")


def check_recovery_metadata(name: str) -> None:
    checkpoints = output(["virsh", "-c", LIBVIRT_URI, "checkpoint-list", name, "--name"])
    if checkpoints:
        raise KVMError(
            f"Backup checkpoints exist for {name}. Finish backup work and explicitly "
            "retire its incremental baseline with the backup tool before retrying. "
            "After disk replacement, establish a new full Backup; do not reuse the old baseline."
        )
    if output(["virsh", "-c", LIBVIRT_URI, "snapshot-list", name, "--name"]):
        raise KVMError(f"Conflicting recovery operation: {name} has snapshots; resolve them with their owning tool first")
    if is_running_state(domain_state(name)):
        job = output(["virsh", "-c", LIBVIRT_URI, "domjobinfo", name])
        fields = dict(line.split(":", 1) for line in job.splitlines() if ":" in line)
        if fields.get("Job type", "unknown").strip().lower() != "none":
            raise KVMError(f"Conflicting recovery operation on {name}; wait for its domain job to finish")


def checked_domain_disk(name: str, state: Optional[Dict[str, Any]]) -> Path:
    """Fail closed unless live and persistent XML describe one independent disk."""
    paths = []
    for flags in ([], ["--inactive"]):
        try:
            root = ET.fromstring(output(["virsh", "-c", LIBVIRT_URI, "dumpxml", name] + flags))
        except ET.ParseError as exc:
            raise KVMError(f"Cannot inspect disk topology for {name}: invalid domain XML") from exc
        disks = root.findall("./devices/disk[@device='disk']")
        if len(disks) != 1:
            raise KVMError(f"Unsupported disk topology for {name}; inspect its disks before retrying")
        item = disks[0]
        source = item.find("source")
        if item.get("type") != "file" or source is None or not source.get("file"):
            raise KVMError(f"Unsupported disk topology for {name}; a regular file disk is required")
        if (item.find("./backingStore/source") is not None or item.find("mirror") is not None
                or item.find("shareable") is not None or item.find("readonly") is not None):
            raise KVMError(f"Unsupported disk recovery data for {name}; preserve dependencies and resolve the topology first")
        if not flags and is_running_state(domain_state(name)):
            target = item.find("target")
            if target is None or not target.get("dev"):
                raise KVMError(f"Cannot inspect disk jobs for {name}: missing target")
            job = output(["virsh", "-c", LIBVIRT_URI, "blockjob", name, target.get("dev"), "--info", "--raw"])
            if job:
                raise KVMError(f"Conflicting recovery operation on {name}; wait for its disk job to finish")
        paths.append(Path(source.get("file")).resolve())
    if paths[0] != paths[1] or (state and state.get("disk") and Path(state["disk"]).resolve() != paths[0]):
        raise KVMError(f"Inconsistent disk path for {name}; reconcile domain XML and managed state before retrying")
    if not paths[0].is_file():
        raise KVMError(f"Disk is not a regular file: {paths[0]}")
    info = qemu_img_info(paths[0], shared=is_running_state(domain_state(name)))
    if (info.get("format") != "qcow2" or info.get("backing-filename") or info.get("snapshots")
            or dig(info, "format-specific", "data", "bitmaps")
            or dig(info, "format-specific", "data", "data-file")):
        raise KVMError(
            f"Unsupported disk format or recovery data on {paths[0]}. Preserve the image and its "
            "dependencies; resolve snapshots/backing chains with their owning tool. Retiring "
            "backup bitmaps requires a new full Backup baseline before future incremental backups."
        )
    return paths[0]


def check_storage_dependents(name: str, disk: Path, state: Optional[Dict[str, Any]]) -> None:
    """Inspect defined domains and managed images; external tools must be quiescent."""
    protected = {disk.resolve()}
    if state and state.get("seed"):
        protected.add(Path(state["seed"]).resolve())
    cloud_dirs = {CLOUD_DIR / name}
    if state and state.get("cloud_dir"):
        cloud_dirs.add(Path(state["cloud_dir"]))
    for cloud in cloud_dirs:
        if cloud.exists():
            protected.update(p.resolve() for p in cloud.rglob("*") if p.is_file())

    def protected_path(path: Path) -> bool:
        return path.resolve() in protected or any(
            path.exists() and target.exists() and path.samefile(target) for target in protected
        )

    candidates = {p.resolve() for p in VM_DIR.rglob("*")
                  if p.is_file() and p.resolve() != disk.resolve()}
    for other in output(["virsh", "-c", LIBVIRT_URI, "list", "--all", "--name"]).splitlines():
        if other == name:
            continue
        for flags in ([], ["--inactive"]):
            try:
                root = ET.fromstring(output(["virsh", "-c", LIBVIRT_URI, "dumpxml", other] + flags))
            except ET.ParseError as exc:
                raise KVMError(f"Cannot inspect storage dependencies for {other}") from exc
            for source in root.findall("./devices/disk//source[@file]"):
                candidate = Path(source.get("file")).resolve()
                if protected_path(candidate):
                    raise KVMError(f"Storage is referenced by domain {other}; preserve it and resolve the dependent disk first")
                candidates.add(candidate)
    visited = set()
    while candidates:
        candidate = candidates.pop()
        if candidate in visited:
            continue
        visited.add(candidate)
        if protected_path(candidate):
            raise KVMError(f"Storage has a dependent disk referencing {candidate}; preserve the chain before retrying")
        info = qemu_img_info(candidate, shared=True)
        backing = info.get("full-backing-filename") or info.get("backing-filename")
        if backing:
            parent = Path(backing)
            candidates.add((parent if parent.is_absolute() else candidate.parent / parent).resolve())


@lifecycle_exclusive
def cmd_reinstall(args: argparse.Namespace) -> int:
    require_commands(["virsh", "virt-install", "qemu-img"])
    require_cloud_seed_generator()
    ensure_dirs()
    name = args.name
    if not domain_exists(name):
        raise KVMError(f"Domain does not exist: {name}")

    state = load_state(name)
    def_path = Path(state["definition"]) if state and state.get("definition") else DEF_DIR / f"{name}.yaml"
    if not def_path.exists():
        def_path = DEF_DIR / f"{name}.yaml"
    if not state and not def_path.exists():
        raise KVMError(f"VM '{name}' is not managed by kvm-vm")
    if not def_path.exists():
        raise KVMError(f"Definition file not found for VM '{name}': {def_path}")

    st = domain_state(name)
    if is_running_state(st) and not args.force:
        raise KVMError(f"VM is running ({st}). Shut it down first, or use --force to destroy it before reinstall.")

    raw_cfg = yaml_load(def_path)
    if raw_cfg.get("cloud_init", {}).get("console_password") or vars(args).get("console_password_file") is not None:
        raise KVMError("Console password reinstall is not supported yet; no guest resources changed")
    apply_os_override(
        raw_cfg,
        os_arg=getattr(args, "os", None),
        image_url=getattr(args, "image_url", None),
        image_path=getattr(args, "image_path", None),
        os_variant=getattr(args, "os_variant", None),
    )

    img = dig(raw_cfg, "storage", "image", default={})
    if not (img.get("distro") or img.get("url") or img.get("path")):
        raise KVMError(f"VM '{name}' has no base image configured. Please specify --os to reinstall.")

    # Preserve all existing VM configurations; prevent host env vars from altering configs during reinstall.
    env_keys = [
        "KVM_VM_NAME", "KVM_VM_VCPUS", "KVM_VM_MEMORY", "KVM_VM_MEMORY_MIB",
        "KVM_VM_DISK", "KVM_VM_DISK_GIB", "KVM_VM_BRIDGE", "KVM_VM_MACVTAP",
        "KVM_VM_IPV4", "KVM_VM_GATEWAY", "KVM_VM_DNS", "KVM_VM_OS",
    ]
    saved_env: Dict[str, str] = {}
    for k in env_keys:
        if k in os.environ:
            saved_env[k] = os.environ.pop(k)
    try:
        cfg = normalize_definition(raw_cfg, for_clone=False)
    finally:
        os.environ.update(saved_env)

    if cfg["vm"]["name"] != name:
        raise KVMError(f"Definition VM name '{cfg['vm']['name']}' does not match target VM '{name}'")

    validate_network_attachment(cfg["network"])

    source_dir = def_path.parent
    if state and state.get("definition_source"):
        cand = Path(state["definition_source"]).parent
        if cand.exists():
            source_dir = cand
    resolve_ssh_keys(cfg["cloud_init"]["ssh_authorized_keys"], source_dir)

    if args.dry_run:
        print("dry-run: all pre-flight checks passed")
        print(yaml.safe_dump(cfg, sort_keys=False, allow_unicode=True))
        return 0

    confirm_reinstall(name, args.yes)
    check_recovery_metadata(name)
    current_disk = checked_domain_disk(name, state)
    check_storage_dependents(name, current_disk, state)
    base, default_variant = acquire_base_image(cfg, args.refresh_image)
    disk = current_disk
    # An exclusively created directory owns both conversion intermediates and
    # the prepared image; never remove a previous attempt's staging files.
    staging = Path(tempfile.mkdtemp(prefix=f".{name}-reinstall-", dir=disk.parent))
    tmp_disk = staging / f"{disk.name}.reinstall.tmp"
    replacement_started = False
    completed = False
    try:
        make_disk_from_base(base, tmp_disk, int(cfg["storage"]["disk_gib"]))
        restore_selinux([tmp_disk])
        if is_running_state(domain_state(name)):
            run(["virsh", "-c", LIBVIRT_URI, "destroy", name])
            check_recovery_metadata(name)
            checked_domain_disk(name, state)
            check_storage_dependents(name, current_disk, state)
        undefine_domain(name)
        replacement_started = True
        tmp_disk.replace(disk)
        restore_selinux([disk])
        _, _, _, instance_id = make_cloud_files(cfg, source_dir)
        seed = CLOUD_DIR / name / "seed.img"
        define_vm(cfg, disk, seed, default_variant, no_start=args.no_start)
        orig_def = Path(state["definition_source"]) if state and state.get("definition_source") else def_path
        save_state(cfg, disk, {"type": "base-image", "path": str(base)}, instance_id, orig_def)
        completed = True
    except Exception:
        # Reinstall operates on an existing VM. Its disk and cloud-init files
        # must survive even when undefinition or a later replacement step fails.
        if replacement_started:
            log.error(
                f"Reinstall failed after domain undefinition; replacement may be incomplete. "
                f"Surviving resources were retained for manual recovery: disk={disk}, "
                f"cloud-init={CLOUD_DIR / name}, definition={def_path}, "
                f"state={STATE_DIR / (name + '.json')}. Inspect the domain and reconcile "
                "its disk, seed and management files before starting it or retrying; "
                "the original disk has not been restored."
            )
        else:
            log.error(
                "Reinstall failed before disk replacement; existing disk and management "
                "files were retained. Check the domain state before restarting it; "
                "--force may already have stopped it."
            )
        raise
    finally:
        try:
            shutil.rmtree(staging)
        except OSError as exc:
            message = f"Could not clean reinstall staging {staging}: {exc}. Remove it manually after inspection."
            if completed:
                raise KVMError(f"VM replacement completed, but {message}") from exc
            log.error(message)

    print(f"Reinstalled VM: {name}")
    print(f"Definition:     {DEF_DIR / (name + '.yaml')}")
    print(f"Disk:           {disk}")
    if not args.no_start and cfg["vm"]["start"]:
        print(f"Console:        kvm-vm console {name}")
    return 0


def dominfo_map(name: str) -> Dict[str, str]:
    p = run(["virsh", "-c", LIBVIRT_URI, "dominfo", name], capture=True)
    out: Dict[str, str] = {}
    for line in p.stdout.splitlines():
        if ":" in line:
            k, v = line.split(":", 1)
            out[k.strip()] = v.strip()
    return out


def get_ips(name: str) -> List[str]:
    found: List[str] = []
    seen = set()
    for src in ("agent", "lease", "arp"):
        p = run(["virsh", "-c", LIBVIRT_URI, "domifaddr", name, "--source", src, "--full"], check=False, capture=True)
        if p.returncode != 0:
            continue
        for line in p.stdout.splitlines():
            cols = line.split()
            if len(cols) >= 4 and ("ipv4" in cols or "ipv6" in cols):
                addr = cols[-1]
                if addr not in seen:
                    seen.add(addr)
                    found.append(addr)
    return found


def human_mem(info: Dict[str, str]) -> str:
    raw = info.get("Max memory", "-")
    m = re.match(r"(\d+)\s+KiB", raw)
    if m:
        mib = int(m.group(1)) // 1024
        return f"{mib} MiB"
    return raw


def cmd_list(args: argparse.Namespace) -> int:
    require_commands(["virsh"])
    names = virsh_names()
    rows: List[List[str]] = []
    for name in names:
        managed = "yes" if load_state(name) else "no"
        if args.managed and managed == "no":
            continue
        info = dominfo_map(name)
        ips = get_ips(name) if args.ips and is_running_state(info.get("State", "unknown")) else []
        rows.append([
            name,
            info.get("State", "?"),
            managed,
            info.get("Autostart", "?"),
            info.get("CPU(s)", "?"),
            human_mem(info),
            ",".join(ips) if ips else "-",
        ])
    headers = ["NAME", "STATE", "MANAGED", "AUTOSTART", "VCPU", "MEMORY", "IP"]
    widths = [len(x) for x in headers]
    for row in rows:
        for i, val in enumerate(row):
            widths[i] = max(widths[i], len(val))
    print("  ".join(headers[i].ljust(widths[i]) for i in range(len(headers))))
    print("  ".join("-" * widths[i] for i in range(len(headers))))
    for row in rows:
        print("  ".join(row[i].ljust(widths[i]) for i in range(len(row))))
    return 0


def print_section(title: str, text: str) -> None:
    print(f"\n{title}")
    print("-" * len(title))
    print(text.strip() if text.strip() else "-")


def cmd_status(args: argparse.Namespace) -> int:
    require_commands(["virsh"])
    name = args.name
    if not domain_exists(name):
        raise KVMError(f"Domain does not exist: {name}")
    state = load_state(name)
    info = output(["virsh", "-c", LIBVIRT_URI, "dominfo", name])
    print_section("Domain", info)
    if state:
        print_section("kvm-vm state", json.dumps(state, indent=2))
    else:
        print_section("kvm-vm state", "Unmanaged domain")
    print_section("Disks", output(["virsh", "-c", LIBVIRT_URI, "domblklist", name, "--details"]))
    print_section("Interfaces", output(["virsh", "-c", LIBVIRT_URI, "domiflist", name]))
    ips = get_ips(name)
    print_section("IP addresses", "\n".join(ips) if ips else "No address reported (qemu-guest-agent/lease/ARP may not have data yet).")
    return 0


def confirm_delete(name: str, yes: bool) -> None:
    if yes:
        return
    if not sys.stdin.isatty():
        raise KVMError("Refusing destructive delete without --yes in non-interactive mode")
    ans = input(f"Delete VM '{name}'? Type the VM name to confirm: ")
    if ans != name:
        raise KVMError("Delete cancelled")


def undefine_domain(name: str, *, keep_nvram: bool = False) -> None:
    # First handle common metadata. If NVRAM blocks undefine, retry with --nvram.
    base = ["virsh", "-c", LIBVIRT_URI, "undefine", name, "--managed-save"]
    if keep_nvram:
        base.append("--keep-nvram")
    p = run(base, check=False, capture=True)
    if p.returncode == 0:
        return
    p2 = run(base + ([] if keep_nvram else ["--nvram"]), check=False, capture=True)
    if p2.returncode != 0:
        raise KVMError(f"virsh undefine failed:\n{p.stderr.strip()}\n{p2.stderr.strip()}")


@lifecycle_exclusive
def cmd_delete(args: argparse.Namespace) -> int:
    require_commands(["virsh", "qemu-img"])
    name = args.name
    if not domain_exists(name):
        raise KVMError(f"Domain does not exist: {name}")
    state = load_state(name)
    if not state and not args.keep_storage:
        raise KVMError("This VM is not managed by kvm-vm. Refusing to delete storage; use --keep-storage to undefine the domain only.")
    check_recovery_metadata(name)
    current_disk = checked_domain_disk(name, state)
    if not args.keep_storage:
        check_storage_dependents(name, current_disk, state)
    confirm_delete(name, args.yes)

    st = domain_state(name)
    if is_running_state(st):
        if not args.force:
            raise KVMError(f"VM is running ({st}). Shut it down first, or use --force to destroy it before delete.")
        run(["virsh", "-c", LIBVIRT_URI, "destroy", name])
        check_recovery_metadata(name)
        checked_domain_disk(name, state)
        if not args.keep_storage:
            check_storage_dependents(name, current_disk, state)

    undefine_domain(name, keep_nvram=args.keep_storage)

    if state and not args.keep_storage:
        # Delete only paths created/tracked by this tool. Never use --remove-all-storage,
        # because the VM may have additional user-attached data disks.
        for key in ("disk", "seed"):
            value = state.get(key)
            if value:
                p = Path(value)
                if p.exists() and (str(p).startswith(str(VM_DIR) + os.sep) or str(p).startswith(str(CLOUD_DIR) + os.sep)):
                    p.unlink()
                elif p.exists():
                    log.warning(f"tracked {key} is outside managed directories; not deleting: {p}")
        cdir = Path(state.get("cloud_dir", "")) if state.get("cloud_dir") else None
        if cdir and cdir.exists() and str(cdir).startswith(str(CLOUD_DIR) + os.sep):
            shutil.rmtree(cdir)
        d = state.get("definition")
        if d:
            dp = Path(d)
            if dp.exists() and dp.parent == DEF_DIR:
                dp.unlink()
        sp = STATE_DIR / f"{name}.json"
        if sp.exists():
            sp.unlink()
    elif state:
        print("Storage kept; managed state/definition retained for audit/recovery.")

    print(f"Deleted domain: {name}" + (" (storage kept)" if args.keep_storage else ""))
    return 0


def cmd_console(args: argparse.Namespace) -> int:
    require_commands(["virsh"])
    if not domain_exists(args.name):
        raise KVMError(f"Domain does not exist: {args.name}")
    st = domain_state(args.name)
    if not is_running_state(st):
        raise KVMError(f"VM is not running (state: {st})")
    print("Connecting to serial console. Press Ctrl+] to exit.")
    return run(["virsh", "-c", LIBVIRT_URI, "console", args.name], check=False).returncode


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="kvm-vm", description="Declarative KVM/libvirt VM manager")
    p.add_argument("--version", action="version", version=f"%(prog)s {VERSION}")
    sp = p.add_subparsers(dest="command", required=True)

    q = sp.add_parser("create", help="Create a VM from a YAML definition and cloud image")
    q.add_argument("--console-password-file", help="New credential file in a private administrator-owned directory")
    q.add_argument("definition")
    q.add_argument("--refresh-image", action="store_true", help="Redownload a URL/distro base image")
    q.add_argument("--no-start", action="store_true", help="Define the VM but do not boot it")
    q.add_argument("--dry-run", action="store_true", help="Run all pre-flight checks but do not create the VM")
    q.set_defaults(func=cmd_create)

    q = sp.add_parser("clone", help="Offline full clone of a VM, then sysprep and apply target YAML")
    q.add_argument("--console-password-file", help="Console credential destination (not yet supported for clone)")
    q.add_argument("source", help="Source libvirt domain name; must be shut off")
    q.add_argument("definition", help="Target VM YAML definition")
    q.add_argument("--no-start", action="store_true", help="Define the clone but do not boot it")
    q.add_argument("--dry-run", action="store_true", help="Run all pre-flight checks but do not clone the VM")
    q.set_defaults(func=cmd_clone)

    q = sp.add_parser("reinstall", help="Reinstall an existing VM OS while keeping other configurations unchanged")
    q.add_argument("--console-password-file", help="Console credential destination (not yet supported for reinstall)")
    q.add_argument("name", help="VM domain name to reinstall")
    os_grp = q.add_mutually_exclusive_group()
    os_grp.add_argument("--os", help=f"New operating system distro ({', '.join(sorted(DISTROS))}) or cloud image URL/path")
    os_grp.add_argument("--image-url", help="Cloud image URL to reinstall with")
    os_grp.add_argument("--image-path", help="Local cloud image path to reinstall with")
    q.add_argument("--os-variant", help="libvirt/osinfo OS variant name")
    q.add_argument("--refresh-image", action="store_true", help="Redownload a URL/distro base image")
    q.add_argument("--no-start", action="store_true", help="Define the VM but do not boot it")
    q.add_argument("--force", action="store_true", help="Destroy a running VM before reinstalling")
    q.add_argument("--yes", action="store_true", help="Skip interactive confirmation")
    q.add_argument("--dry-run", action="store_true", help="Run all pre-flight checks but do not reinstall the VM")
    q.set_defaults(func=cmd_reinstall)

    q = sp.add_parser("list", help="List libvirt VMs")
    q.add_argument("--managed", action="store_true", help="Show only VMs managed by kvm-vm")
    q.add_argument("--ips", action="store_true", help="Query IP addresses (slower)")
    q.set_defaults(func=cmd_list)

    q = sp.add_parser("status", help="Show detailed VM status")
    q.add_argument("name")
    q.set_defaults(func=cmd_status)

    q = sp.add_parser("delete", help="Undefine a VM and, for managed VMs, delete only managed storage")
    q.add_argument("name")
    q.add_argument("--yes", action="store_true", help="Skip interactive confirmation")
    q.add_argument("--force", action="store_true", help="Destroy a running VM before deleting")
    q.add_argument("--keep-storage", action="store_true", help="Undefine domain but keep disks/state")
    q.set_defaults(func=cmd_delete)

    q = sp.add_parser("console", help="Attach to the VM serial console")
    q.add_argument("name")
    q.set_defaults(func=cmd_console)

    q = sp.add_parser("validate", help="Validate and normalize a YAML definition without touching libvirt")
    q.add_argument("definition")
    q.add_argument("--clone", action="store_true", help="Validate as a clone target (image source optional)")
    q.set_defaults(func=cmd_validate)

    return p


def main() -> int:
    logging.basicConfig(format="%(levelname)s: %(message)s", level=logging.INFO)
    try:
        parser = build_parser()
        args = parser.parse_args()
        return int(args.func(args))
    except KVMError as exc:
        log.error(f"{exc}")
        return 1
    except subprocess.CalledProcessError as exc:
        log.error(f"command failed ({exc.returncode}): {' '.join(map(str, exc.cmd))}")
        if getattr(exc, "stderr", None):
            log.error(exc.stderr.strip())
        return exc.returncode or 1
    except KeyboardInterrupt:
        log.info("Interrupted")
        return 130


if __name__ == "__main__":
    sys.exit(main())
