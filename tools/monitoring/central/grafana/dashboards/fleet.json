{
  "id": null,
  "uid": "kvm-vm-fleet",
  "title": "KVM Fleet Overview",
  "description": "Central fleet health. Host absence requires an explicit inventory.",
  "tags": [
    "kvm-vm",
    "central",
    "fleet"
  ],
  "schemaVersion": 41,
  "version": 1,
  "timezone": "browser",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "editable": false,
  "graphTooltip": 1,
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "site",
        "label": "Site",
        "type": "query",
        "hide": 0,
        "datasource": {
          "type": "prometheus",
          "uid": "kvm-vm-victoriametrics"
        },
        "query": "label_values(kvm_vm_collector_success,site)",
        "definition": "label_values(kvm_vm_collector_success,site)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "refresh": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Hosts reporting",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "kvm-vm-victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kvm-vm-victoriametrics"
          },
          "expr": "count(count by(host_id)(kvm_vm_collector_success{site=~\"$site\"})) or vector(0)",
          "refId": "A",
          "legendFormat": "{{host}}"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "title": "Running VMs",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "kvm-vm-victoriametrics"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kvm-vm-victoriametrics"
          },
          "expr": "count(kvm_vm_domain_state{state=\"running\",site=~\"$site\"}) or vector(0)",
          "refId": "A",
          "legendFormat": "{{host}}"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "title": "Collector errors",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "kvm-vm-victoriametrics"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kvm-vm-victoriametrics"
          },
          "expr": "count(kvm_vm_collector_success{site=~\"$site\"} == 0) or vector(0)",
          "refId": "A",
          "legendFormat": "{{host}}"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "textMode": "auto"
      }
    },
    {
      "id": 4,
      "title": "VM CPU cores used",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "kvm-vm-victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kvm-vm-victoriametrics"
          },
          "expr": "sum by (host_id,host)(rate(kvm_vm_domain_cpu_time_seconds_total{site=~\"$site\"}[5m]))",
          "refId": "A",
          "legendFormat": "{{host}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        }
      }
    },
    {
      "id": 5,
      "title": "VM assigned memory",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "kvm-vm-victoriametrics"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kvm-vm-victoriametrics"
          },
          "expr": "sum by (host_id,host)(kvm_vm_domain_memory_assigned_bytes{site=~\"$site\"})",
          "refId": "A",
          "legendFormat": "{{host}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        }
      }
    },
    {
      "id": 6,
      "title": "Disk read throughput",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "kvm-vm-victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kvm-vm-victoriametrics"
          },
          "expr": "sum by(host_id,host)(rate(kvm_vm_domain_disk_read_bytes_total{site=~\"$site\"}[5m]))",
          "refId": "A",
          "legendFormat": "{{host}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        }
      }
    },
    {
      "id": 7,
      "title": "Network receive throughput",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "kvm-vm-victoriametrics"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kvm-vm-victoriametrics"
          },
          "expr": "sum by(host_id,host)(rate(kvm_vm_domain_network_receive_bytes_total{site=~\"$site\"}[5m]))",
          "refId": "A",
          "legendFormat": "{{host}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        }
      }
    }
  ]
}
