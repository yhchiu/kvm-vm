    {
      "id": 8,
      "title": "Expected hosts by inventory",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "kvm-vm-victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kvm-vm-victoriametrics"
          },
          "expr": "count(kvm_vm_host_expected{site=~\"$site\"}) or vector(0)",
          "refId": "A",
          "legendFormat": "{{host}}"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "textMode": "auto"
      }
    },
    {
      "id": 9,
      "title": "Hosts offline by inventory",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "kvm-vm-victoriametrics"
      },
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 12,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kvm-vm-victoriametrics"
          },
          "expr": "count(kvm_vm_host_expected{site=~\"$site\"} unless on(host_id) max by(host_id)(count_over_time(kvm_vm_collector_success[5m]))) or vector(0)",
          "refId": "A",
          "legendFormat": "{{host}}"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "textMode": "auto"
      }
    },
    {
      "id": 10,
      "title": "Agent pending queue",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "kvm-vm-victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kvm-vm-victoriametrics"
          },
          "expr": "sum by(host_id,host)(vmagent_remotewrite_pending_data_bytes{job=\"vmagent\",site=~\"$site\"})",
          "refId": "A",
          "legendFormat": "{{host_id}} / {{host}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        }
      }
    },
    {
      "id": 11,
      "title": "Hybrid send lag",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "kvm-vm-victoriametrics"
      },
      "gridPos": {
        "x": 12,
        "y": 26,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kvm-vm-victoriametrics"
          },
          "expr": "prometheus_remote_storage_queue_highest_timestamp_seconds{job=\"prometheus-writer\",site=~\"$site\"} - prometheus_remote_storage_queue_highest_sent_timestamp_seconds{job=\"prometheus-writer\",site=~\"$site\"}",
          "refId": "A",
          "legendFormat": "{{host_id}} / {{host}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        }
      }
    },
    {
      "id": 12,
      "title": "Collector sample age (transport / clock)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "kvm-vm-victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kvm-vm-victoriametrics"
          },
          "expr": "time() - timestamp(kvm_vm_collector_success{site=~\"$site\"})",
          "refId": "A",
          "legendFormat": "{{host_id}} / {{host}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        }
      }
