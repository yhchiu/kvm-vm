{
  "id": null,
  "uid": "kvm-vm-local",
  "title": "KVM VM Overview",
  "description": "Read-only libvirt VM metrics from kvm-vm exporter; guest used RAM depends on fresh balloon stats.",
  "tags": [
    "kvm-vm",
    "libvirt",
    "local"
  ],
  "schemaVersion": 41,
  "version": 1,
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "15s",
  "editable": false,
  "graphTooltip": 1,
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "vm",
        "label": "VM",
        "type": "query",
        "hide": 0,
        "datasource": {
          "type": "prometheus",
          "uid": "kvm-vm-prometheus"
        },
        "query": "label_values(kvm_vm_domain_state, vm)",
        "definition": "label_values(kvm_vm_domain_state, vm)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "refresh": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      },
      {
        "name": "vm_id",
        "label": "VM UUID",
        "type": "query",
        "hide": 0,
        "datasource": {
          "type": "prometheus",
          "uid": "kvm-vm-prometheus"
        },
        "query": "label_values(kvm_vm_domain_state{vm=~\"$vm\"}, vm_id)",
        "definition": "label_values(kvm_vm_domain_state{vm=~\"$vm\"}, vm_id)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "refresh": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Exporter healthy",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "kvm-vm-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kvm-vm-prometheus"
          },
          "expr": "kvm_vm_collector_success",
          "legendFormat": "1 = healthy",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value"
      }
    },
    {
      "id": 2,
      "title": "Running VMs",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "kvm-vm-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kvm-vm-prometheus"
          },
          "expr": "count(kvm_vm_domain_state{state=\"running\"}) or vector(0)",
          "legendFormat": "running",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value"
      }
    },
    {
      "id": 3,
      "title": "Total assigned vCPUs",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "kvm-vm-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kvm-vm-prometheus"
          },
          "expr": "sum(kvm_vm_domain_vcpus{vm=~\"$vm\",vm_id=~\"$vm_id\"}) or vector(0)",
          "legendFormat": "vCPU",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value"
      }
    },
    {
      "id": 4,
      "title": "VM CPU utilization (% of assigned vCPUs)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "kvm-vm-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "kvm-vm-prometheus"
          },
          "expr": "100 * kvm_vm_domain_cpu_usage_ratio{vm=~\"$vm\",vm_id=~\"$vm_id\"}",
          "legendFormat": "{{vm}} [{{vm_id}}]",
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 5,
      "title": "VM CPU cores used",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "kvm-vm-prometheus"
