          "expr": "sum by (vm,vm_id) (rate(kvm_vm_domain_disk_read_time_seconds_total{vm=~\"$vm\",vm_id=~\"$vm_id\"}[5m])) / (sum by (vm,vm_id) (rate(kvm_vm_domain_disk_read_operations_total{vm=~\"$vm\",vm_id=~\"$vm_id\"}[5m])) > 0)",
          "legendFormat": "{{vm}} [{{vm_id}}] read",
