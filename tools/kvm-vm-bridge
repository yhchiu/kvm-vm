# Persistent configuration (written only on confirm)
# ---------------------------------------------------------------------------

def write_persistent(meta: Dict[str, Any]) -> List[str]:
    backend = meta["backend"]
    if backend == "ifupdown":
        return persist_ifupdown(meta)
    if backend == "networkmanager":
        return persist_networkmanager(meta)
    if backend == "networkd":
        return persist_networkd(meta)
    log("backend is runtime-only; skipping persistent configuration")
    return []


def persist_ifupdown(meta: Dict[str, Any]) -> List[str]:
    uplink = meta["uplink"]
    bridge = meta["bridge"]
    v4 = meta.get("ipv4") or []
    if not v4:
        raise BridgeError("ifupdown persist currently requires a global IPv4 address on the uplink")
    primary = v4[0]
    address = cidr_of(primary)
    gw = meta.get("gateway")
    dns, search = _ifupdown_dns()

    written: List[str] = []
    conf_dir = etc_path("network", "interfaces.d")
    conf_dir.mkdir(parents=True, exist_ok=True)
    # Comment the original uplink stanza so ifupdown does not configure it twice.
    _comment_ifupdown_iface(uplink, backup_note="disabled by kvm-vm-bridge")

    path = conf_dir / f"kvm-vm-bridge-{bridge}.conf"
    parts = [
        f"# Written by kvm-vm-bridge on {utc_now()}. Removed on rollback.",
        f"auto {uplink}",
        f"iface {uplink} inet manual",
        "",
        f"auto {bridge}",
        f"iface {bridge} inet static",
        f"    address {address}",
    ]
    if gw:
        parts.append(f"    gateway {gw}")
    if dns:
        parts.append("    dns-nameservers " + " ".join(dns))
    if search:
        parts.append("    dns-search " + " ".join(search))
    # Prefer native bridge_ports when the hook exists; always include iproute2 pre-up
    # so persist works without the bridge-utils package.
    parts += [
        f"    pre-up ip link add name {bridge} type bridge 2>/dev/null || true",
        f"    pre-up ip link set dev {bridge} type bridge stp_state 0 forward_delay 0",
        f"    pre-up ip link set dev {bridge} address {meta['uplink_mac']}",
        f"    pre-up ip link set dev {uplink} up",
        f"    pre-up ip link set dev {uplink} master {bridge}",
        f"    pre-up ip link set dev {bridge} up",
        f"    post-down ip link set dev {uplink} nomaster 2>/dev/null || true",
        f"    post-down ip link set dev {bridge} down 2>/dev/null || true",
        f"    post-down ip link delete dev {bridge} 2>/dev/null || true",
        "",
    ]
    path.write_text("\n".join(parts), encoding="utf-8")
    os.chmod(path, 0o644)
    written.append(str(path))
    log(f"wrote ifupdown config {path}")
    return written


def _ifupdown_dns() -> Tuple[List[str], List[str]]:
    dns: List[str] = []
    search: List[str] = []
    path = etc_path("network", "interfaces")
    if path.exists():
        for line in path.read_text(encoding="utf-8", errors="replace").splitlines():
            s = line.strip()
            if s.startswith("dns-nameservers"):
                dns = s.split()[1:]
            elif s.startswith("dns-search"):
                search = s.split()[1:]
    if not dns:
        resolv = etc_path("resolv.conf")
        if resolv.exists():
            for line in resolv.read_text(encoding="utf-8", errors="replace").splitlines():
                parts = line.split()
                if len(parts) >= 2 and parts[0] == "nameserver":
                    dns.append(parts[1])
                elif len(parts) >= 2 and parts[0] == "search":
                    search = parts[1:]
    return dns, search


def _comment_ifupdown_iface(iface: str, backup_note: str) -> None:
    """Comment out auto/allow-hotplug/iface stanzas for iface in interfaces (not interfaces.d)."""
    path = etc_path("network", "interfaces")
    if not path.exists():
        return
    original = path.read_text(encoding="utf-8", errors="replace")
    lines = original.splitlines()
    out: List[str] = []
    i = 0
    changed = False
    while i < len(lines):
        stripped = lines[i].strip()
        tokens = stripped.split()
        if tokens and tokens[0] in {"auto", "allow-hotplug", "allow-auto"} and iface in tokens[1:]:
            out.append(f"# kvm-vm-bridge: {backup_note}")
            out.append("# " + lines[i])
            changed = True
            i += 1
            continue
        if tokens and tokens[0] == "iface" and len(tokens) >= 2 and tokens[1] == iface:
            out.append(f"# kvm-vm-bridge: {backup_note}")
            out.append("# " + lines[i])
            i += 1
            while i < len(lines):
                nxt = lines[i]
                if nxt.strip() and not nxt.startswith((" ", "\t", "#")):
                    break
                out.append("# " + nxt if nxt else "#")
                i += 1
            changed = True
            continue
        out.append(lines[i])
        i += 1
    if changed:
        path.write_text("\n".join(out) + "\n", encoding="utf-8")
        log(f"commented original ifupdown stanza for {iface} in {path}")


def persist_networkmanager(meta: Dict[str, Any]) -> List[str]:
    if which("nmcli") is None:
        raise BridgeError("NetworkManager persist requires nmcli")
    uplink = meta["uplink"]
    bridge = meta["bridge"]
    v4 = meta.get("ipv4") or []
    if not v4:
        raise BridgeError("NetworkManager persist currently requires a global IPv4 address")
    address = cidr_of(v4[0])
    gw = meta.get("gateway")
    br_con = f"kvm-vm-bridge-{bridge}"
    sl_con = f"kvm-vm-bridge-{bridge}-slave"
    # Delete leftovers from a previous attempt
    run(["nmcli", "connection", "delete", br_con], check=False, capture=True)
    run(["nmcli", "connection", "delete", sl_con], check=False, capture=True)

    add_br = [
        "nmcli", "connection", "add", "type", "bridge", "ifname", bridge,
        "con-name", br_con,
        "connection.autoconnect", "yes",
        "bridge.stp", "no",
        "bridge.forward-delay", "0",
        "ipv4.method", "manual",
        "ipv4.addresses", address,
        "ipv6.method", "ignore",
    ]
    if gw:
        add_br += ["ipv4.gateway", str(gw)]
    dns, _search = _ifupdown_dns()
    if dns:
        add_br += ["ipv4.dns", ",".join(dns)]
    run(add_br)
    run([
        "nmcli", "connection", "add", "type", "ethernet", "ifname", uplink,
        "con-name", sl_con, "master", br_con,
        "connection.autoconnect", "yes",
    ])
    # Leave the previous uplink connection in place but do not autoconnect it.
    old = nm_device_connection(uplink)
    if old and old not in {br_con, sl_con}:
        run(["nmcli", "connection", "modify", old, "connection.autoconnect", "no"], check=False)
        meta["nm_old_connection"] = old
        meta["nm_old_autoconnect_disabled"] = True
    log(f"created NetworkManager connections {br_con} and {sl_con} (not downing the live device)")
    # Do not nmcli con up here: runtime is already correct; bouncing can drop SSH.
    return [br_con, sl_con]


def persist_networkd(meta: Dict[str, Any]) -> List[str]:
    uplink = meta["uplink"]
    bridge = meta["bridge"]
    v4 = meta.get("ipv4") or []
    if not v4:
        raise BridgeError("systemd-networkd persist currently requires a global IPv4 address")
    netdir = etc_path("systemd", "network")
    netdir.mkdir(parents=True, exist_ok=True)
    netdev = netdir / f"10-kvm-vm-bridge-{bridge}.netdev"
    brnet = netdir / f"10-kvm-vm-bridge-{bridge}.network"
    slnet = netdir / f"10-kvm-vm-bridge-{uplink}.network"
    address = cidr_of(v4[0])
    gw = meta.get("gateway")
    netdev.write_text(
        "\n".join([
            f"# Written by kvm-vm-bridge on {utc_now()}.",
            "[NetDev]",
            f"Name={bridge}",
            "Kind=bridge",
            f"MACAddress={meta['uplink_mac']}",
            "[Bridge]",
            "STP=no",
            "ForwardDelaySec=0",
            "",
        ]),
        encoding="utf-8",
    )
    br_lines = [
        f"# Written by kvm-vm-bridge on {utc_now()}.",
        "[Match]",
        f"Name={bridge}",
        "[Network]",
        f"Address={address}",
    ]
    if gw:
        br_lines.append(f"Gateway={gw}")
    dns, search = _ifupdown_dns()
    for d in dns:
        br_lines.append(f"DNS={d}")
    if search:
        br_lines.append("Domains=" + " ".join(search))
    br_lines.append("")
    brnet.write_text("\n".join(br_lines), encoding="utf-8")
    slnet.write_text(
        "\n".join([
            f"# Written by kvm-vm-bridge on {utc_now()}.",
            "[Match]",
            f"Name={uplink}",
            "[Network]",
            f"Bridge={bridge}",
            "",
        ]),
        encoding="utf-8",
    )
    log(f"wrote systemd-networkd files {netdev}, {brnet}, {slnet} (not reloaded)")
    return [str(netdev), str(brnet), str(slnet)]


def remove_persistent(meta: Dict[str, Any]) -> None:
    if not meta.get("persist_written"):
        return
    backend = meta["backend"]
    written = meta.get("persist_paths") or []
    if backend == "ifupdown":
        for path in written:
            p = Path(path)
            if p.exists() and "kvm-vm-bridge-" in p.name:
                p.unlink()
                log(f"removed {p}")
        # Restore original interfaces file from the snapshot
        snap = session_dir(meta["bridge"]) / "files" / "interfaces"
        dest = etc_path("network", "interfaces")
        if snap.exists():
            shutil.copy2(snap, dest)
            log(f"restored {dest} from the snapshot")
        idest = etc_path("network", "interfaces.d")
        isnap = session_dir(meta["bridge"]) / "files" / "interfaces.d"
        if isnap.exists() and idest.exists():
            # remove only our file; other files already restored if we copied the tree
            pass
    elif backend == "networkmanager":
        for name in written:
            run(["nmcli", "connection", "delete", name], check=False, capture=True)
            log(f"deleted NetworkManager connection {name}")
        old = meta.get("nm_old_connection")
        if old and meta.get("nm_old_autoconnect_disabled"):
            run(["nmcli", "connection", "modify", old, "connection.autoconnect", "yes"], check=False)
            log(f"re-enabled autoconnect on {old}")
    elif backend == "networkd":
        for path in written:
            p = Path(path)
            if p.exists() and "kvm-vm-bridge-" in p.name:
                p.unlink()
                log(f"removed {p}")


