def plan_text(bridge: str, uplink: str, backend: str, timeout: int) -> str:
    v4 = global_ipv4(uplink)
    v6 = global_ipv6(uplink)
    defaults = default_routes_for(uplink)
    addrs = ", ".join(cidr_of(a) for a in v4 + v6) or "(none)"
    gw = defaults[0].get("gateway") if defaults else None
    lines = [
        f"backend:          {backend_label(backend)}",
        f"uplink:            {uplink}  mac={interface_mac(uplink)}  operstate={(sys_net(uplink) / 'operstate').read_text(encoding='utf-8').strip()}",
        f"bridge to create:  {bridge}",
        f"addresses to move: {addrs}",
        f"default gateway:   {gw}",
        f"rollback timeout:  {timeout} seconds",
        f"state directory:   {session_dir(bridge)}",
        f"log file:          {LOG_FILE}",
        "",
        "create will:",
        "  1. snapshot the current addresses, routes and network config files",
        "  2. arm a rollback timer that restores the snapshot unless you confirm",
        "  3. create the bridge with STP off and forward_delay 0 (no 30s blocking)",
        "  4. copy the uplink MAC onto the bridge, move addresses and the default route",
        "  5. enslave the uplink",
        "Persistent configuration is NOT written until:  kvm-vm-bridge confirm",
        "A reboot during the trial window therefore returns the previous config.",
        "Confirm with:  kvm-vm-bridge confirm --bridge " + bridge,
        "Roll back with: kvm-vm-bridge rollback --bridge " + bridge + " --yes",
    ]
    return "\n".join(lines)


def _read_sysctl(path: Path) -> Optional[str]:
    try:
        return path.read_text(encoding="utf-8").strip()
    except OSError:
        return None


def bridge_calls_iptables(bridge: str) -> Optional[str]:
    """1 when bridged IPv4 on this bridge is passed to iptables.

    A per-bridge nf_call_iptables wins over the global sysctl. The per-bridge
    file exists only after the bridge is created and br_netfilter is loaded.
    """
    per_bridge = _read_sysctl(sys_net(bridge) / "bridge" / "nf_call_iptables")
    if per_bridge is not None:
        return per_bridge
    return _read_sysctl(Path("/proc/sys/net/bridge/bridge-nf-call-iptables"))


def read_filter_facts(bridge: str) -> Dict[str, Any]:
    """Best-effort look at br_netfilter and the IPv4 FORWARD chain."""
    facts: Dict[str, Any] = {
        "br_netfilter": Path("/sys/module/br_netfilter").exists(),
        "call_iptables": bridge_calls_iptables(bridge),
        "rules": "",
        "readable": False,
        "format": None,
    }
    if which("iptables"):
        proc = run(["iptables", "-S", "FORWARD"], check=False, capture=True)
        if proc.returncode == 0:
            facts["rules"] = proc.stdout
            facts["readable"] = True
            facts["format"] = "iptables"
            return facts
    if which("nft"):
        proc = run(["nft", "list", "chain", "ip", "filter", "FORWARD"], check=False, capture=True)
        if proc.returncode == 0:
            facts["rules"] = proc.stdout
            facts["readable"] = True
            facts["format"] = "nft"
            return facts
    return facts


def _accepts_direction(tokens: List[str], bridge: str, direction: str) -> bool:
    """True when an iptables rule ACCEPTs traffic for direction (-i or -o)."""
    if "-j" not in tokens:
        return False
    jump_at = tokens.index("-j")
    if jump_at + 1 >= len(tokens) or tokens[jump_at + 1] != "ACCEPT":
        return False
    long_opt = "--in-interface" if direction == "-i" else "--out-interface"
    other = "-o" if direction == "-i" else "-i"
    other_long = "--out-interface" if direction == "-i" else "--in-interface"
    iface = None
    if direction in tokens:
        at = tokens.index(direction)
        if at + 1 < len(tokens):
            iface = tokens[at + 1]
    elif long_opt in tokens:
        at = tokens.index(long_opt)
        if at + 1 < len(tokens):
            iface = tokens[at + 1]
    if iface is None:
        # No match on this direction. A rule with no interface match at all
        # accepts every forwarded packet. A rule that names only the other
        # direction does not.
        return other not in tokens and other_long not in tokens
    return iface == bridge


def parse_iptables_forward(text: str, bridge: str) -> Tuple[Optional[str], bool, bool]:
    """Return (policy, accepts_in, accepts_out) from `iptables -S FORWARD`."""
    policy = None
    accept_in = False
    accept_out = False
    for raw in text.splitlines():
        tokens = raw.split()
        if len(tokens) >= 3 and tokens[0] == "-P" and tokens[1] == "FORWARD":
            policy = tokens[2].upper()
            continue
        if len(tokens) < 3 or tokens[0] != "-A" or tokens[1] != "FORWARD":
            continue
        body = tokens[2:]
        if _accepts_direction(body, bridge, "-i"):
            accept_in = True
        if _accepts_direction(body, bridge, "-o"):
            accept_out = True
    return policy, accept_in, accept_out


def parse_nft_forward(text: str, bridge: str) -> Tuple[Optional[str], bool, bool]:
    """Return (policy, accepts_in, accepts_out) from `nft list chain ip filter FORWARD`."""
    policy = None
    accept_in = False
    accept_out = False
    quoted = '"' + bridge + '"'
    for raw in text.splitlines():
        line = " ".join(raw.strip().rstrip(";").split())
        if "policy " in line:
            policy = line.split("policy", 1)[1].strip().split()[0].upper()
        if not line.endswith(" accept") and " accept " not in (" " + line + " "):
            continue
        has_in = f"iifname {quoted}" in line or f"iif {quoted}" in line
        has_out = f"oifname {quoted}" in line or f"oif {quoted}" in line
        if has_in:
            accept_in = True
        if has_out:
            accept_out = True
        if not has_in and not has_out and "iifname" not in line and "oifname" not in line and "iif " not in line and "oif " not in line:
            if line == "accept" or line.endswith(" accept"):
                accept_in = True
                accept_out = True
    return policy, accept_in, accept_out


def bridged_ipv4_warning(bridge: str, facts: Optional[Dict[str, Any]] = None) -> Optional[str]:
    """Warn when br_netfilter would drop bridged guest IPv4.

    This is a hint, not a refusal. Host SSH to a guest on the same bridge
    does not use the FORWARD chain, so the bridge can look healthy while
    guests still cannot reach their gateway. The check looks only at the
    FORWARD chain itself; a jump to another chain that would ACCEPT is not
    followed.
    """
    facts = read_filter_facts(bridge) if facts is None else facts
    if not facts.get("br_netfilter"):
        return None
    if str(facts.get("call_iptables")) != "1":
        return None
    if not facts.get("readable"):
        return (
            f"br_netfilter is loaded and net.bridge.bridge-nf-call-iptables=1, "
            f"but the IPv4 FORWARD policy could not be read. Guests bridged on {bridge} "
            f"may have no IPv4 connectivity if FORWARD drops their traffic. "
            f"To allow it without setting the FORWARD policy to ACCEPT: "
            f"iptables -I FORWARD 1 -i {bridge} -j ACCEPT && "
            f"iptables -I FORWARD 1 -o {bridge} -j ACCEPT. "
            "See docs/networking.md#bridged-guests-and-the-host-firewall."
        )
    if facts.get("format") == "nft":
        policy, accept_in, accept_out = parse_nft_forward(str(facts.get("rules") or ""), bridge)
    else:
        policy, accept_in, accept_out = parse_iptables_forward(str(facts.get("rules") or ""), bridge)
    if policy not in {"DROP", "REJECT"}:
        return None
    if accept_in and accept_out:
        return None
    missing = []
    if not accept_in:
        missing.append(f"traffic forwarded from {bridge} (-i {bridge})")
    if not accept_out:
        missing.append(f"traffic forwarded to {bridge} (-o {bridge})")
    return (
        f"Bridged guest IPv4 on {bridge} is likely to be dropped. "
        f"br_netfilter is loaded, net.bridge.bridge-nf-call-iptables=1, and the IPv4 "
        f"FORWARD policy is {policy}, with no ACCEPT for " + " or ".join(missing) + ". "
        "The host can still reach a guest on the same bridge; that path does not use FORWARD. "
        f"Allow FORWARD for {bridge} without setting the policy to ACCEPT: "
        f"iptables -I FORWARD 1 -i {bridge} -j ACCEPT && "
        f"iptables -I FORWARD 1 -o {bridge} -j ACCEPT. "
        "See docs/networking.md#bridged-guests-and-the-host-firewall."
    )


def emit_forward_warning(bridge: str) -> None:
    message = bridged_ipv4_warning(bridge)
    if not message:
        return
    eprint("WARNING: " + message)
    try:
        LOG_FILE.parent.mkdir(parents=True, exist_ok=True)
        with LOG_FILE.open("a", encoding="utf-8") as fh:
            fh.write(f"{utc_now()} WARNING: {message}\n")
    except OSError:
        pass


def preflight(bridge: str, uplink: str) -> None:
    require_commands(["ip"])
    if not link_exists(uplink):
        raise BridgeError(f"Uplink not found: {uplink}")
    if not link_is_up(uplink):
        raise BridgeError(f"Uplink {uplink} is not up; bring it up before creating a bridge")
    if is_bridge(uplink):
        raise BridgeError(f"{uplink} is already a bridge")
    master = is_enslaved(uplink)
    if master:
        raise BridgeError(f"{uplink} is already enslaved to {master}")
    if link_exists(bridge):
        raise BridgeError(f"Bridge {bridge} already exists; choose another name or delete it first")
    if not global_ipv4(uplink) and not global_ipv6(uplink):
        raise BridgeError(f"Uplink {uplink} has no global IP address to migrate")
    if not default_routes_for(uplink):
        eprint(f"WARNING: no default route currently uses {uplink}")


def cmd_create(args: argparse.Namespace) -> int:
    require_root()
    bridge = args.bridge
    uplink = args.uplink
    timeout = int(args.timeout)
    preflight(bridge, uplink)
    emit_forward_warning(bridge)
    backend = detect_backend(uplink)
    log(f"create requested: bridge={bridge} uplink={uplink} backend={backend} timeout={timeout} dry_run={args.dry_run}")
    print(plan_text(bridge, uplink, backend, timeout))
    if args.dry_run:
        print("dry-run: no changes made")
        return 0

    sdir = snapshot_system(bridge, uplink, backend, timeout)
    meta = load_meta(bridge)
    try:
        wd = arm_watchdog(bridge, timeout, sdir)
        meta["watchdog"] = wd
        meta["status"] = "armed"
        save_json(sdir / "meta.json", meta)
        apply_runtime(bridge, uplink, meta)
        verify_runtime(bridge, uplink, meta)
        meta["status"] = "pending-confirm"
        save_json(sdir / "meta.json", meta)
    except Exception as exc:
        log(f"create failed, rolling back immediately: {exc}")
        try:
            run(["/bin/bash", str(sdir / "rollback.sh")], check=False)
        finally:
            # Keep the watchdog running only if we may have lost access mid-change.
            # If we still have a usable default route on the original uplink, cancel it.
            try:
                if default_routes_for(uplink) and not link_exists(bridge):
                    cancel_watchdog(meta)
                    # leave snapshot for inspection? On failure after snapshot,
                    # rename the session so a retry can proceed.
                    failed = STATE_DIR / "failed" / f"{bridge}-{time.strftime('%Y%m%dT%H%M%S')}"
                    failed.parent.mkdir(parents=True, exist_ok=True)
                    if sdir.exists():
                        shutil.move(str(sdir), str(failed))
                    log(f"moved failed session to {failed}")
            except Exception as exc2:
                log(f"could not tidy the failed session: {exc2}")
        raise

    print()
    print(f"Bridge {bridge} is up. Confirm within {timeout} seconds or it will be rolled back:")
    print(f"  kvm-vm-bridge confirm --bridge {bridge}")
    print("To roll back now:")
    print(f"  kvm-vm-bridge rollback --bridge {bridge} --yes")
    return 0


def cmd_confirm(args: argparse.Namespace) -> int:
    require_root()
    bridge = args.bridge
    meta = load_meta(bridge)
    if meta.get("confirmed"):
        print(f"{bridge} is already confirmed")
        return 0
    if meta.get("status") not in {"pending-confirm", "armed"}:
        raise BridgeError(f"Session for {bridge} is not waiting for confirm (status={meta.get('status')})")
    # Verify the bridge is still healthy before cancelling the watchdog.
    # Warn before confirm as well: create may have been non-interactive, and
    # the per-bridge nf_call_iptables value exists only once the bridge does.
    verify_runtime(bridge, meta["uplink"], meta)
    emit_forward_warning(bridge)
    sdir = session_dir(bridge)
    (sdir / "CONFIRMED").write_text(utc_now() + "\n", encoding="utf-8")
    cancel_watchdog(meta)
    written: List[str] = []
    if not args.no_persist:
        written = write_persistent(meta)
        meta["persist_written"] = True
        meta["persist_paths"] = written
    else:
        log("confirm --no-persist: timer cancelled, persistent config not written")
    meta["confirmed"] = True
    meta["confirmed_at"] = utc_now()
    meta["status"] = "confirmed"
    save_json(sdir / "meta.json", meta)
    # rewrite rollback script still valid for later explicit rollback
    print(f"Confirmed. Auto-rollback for {bridge} is cancelled.")
    if written:
        print("Persistent configuration written (takes effect on reboot or a later network service restart):")
        for w in written:
            print(f"  {w}")
    print(f"To restore the previous configuration later: kvm-vm-bridge rollback --bridge {bridge} --yes")
    return 0


def cmd_rollback(args: argparse.Namespace) -> int:
    bridge = args.bridge
    if not args.yes:
        raise BridgeError("Refusing to roll back without --yes")
    require_root()
    # Rollback must work even if meta is half-written: prefer the generated script.
    sdir = session_dir(bridge)
    script = sdir / "rollback.sh"
    if not script.exists():
        raise BridgeError(f"No rollback script at {script}")
    meta: Dict[str, Any]
    try:
        meta = load_meta(bridge)
    except BridgeError:
        meta = {"bridge": bridge, "backend": "runtime", "persist_written": False, "watchdog": {"method": "systemd-run", "unit": watchdog_unit(bridge)}}
    log(f"explicit rollback of {bridge} requested")
    (sdir / "CONFIRMED").write_text("rollback\n", encoding="utf-8")  # stop watchdog even if we are racing
    cancel_watchdog(meta)
    try:
        remove_persistent(meta)
    except Exception as exc:
        log(f"persistent cleanup reported: {exc}")
    p = run(["/bin/bash", str(script)], check=False)
    if p.returncode != 0:
        raise BridgeError(f"rollback.sh exited {p.returncode}; inspect {LOG_FILE}")
    meta["status"] = "rolled-back"
    meta["rolled_back_at"] = utc_now()
    try:
        save_json(sdir / "meta.json", meta)
        archived = STATE_DIR / "archived" / f"{bridge}-{time.strftime('%Y%m%dT%H%M%S')}"
        archived.parent.mkdir(parents=True, exist_ok=True)
        shutil.move(str(sdir), str(archived))
        log(f"archived session to {archived}")
    except Exception as exc:
        log(f"could not archive session: {exc}")
    print(f"Rolled back {bridge}.")
    return 0


def cmd_status(args: argparse.Namespace) -> int:
    if args.bridge:
        bridges = [args.bridge]
    else:
        root = STATE_DIR / "sessions"
        bridges = sorted(p.name for p in root.iterdir()) if root.exists() else []
        if not bridges:
            print("No kvm-vm-bridge sessions.")
            return 0
    rc = 0
    for bridge in bridges:
        try:
            meta = load_meta(bridge)
        except BridgeError as exc:
            eprint(str(exc))
            rc = 1
            continue
        print(f"bridge:     {bridge}")
        print(f"uplink:     {meta.get('uplink')}")
        print(f"backend:   {backend_label(meta.get('backend') or 'runtime')}")
        print(f"status:     {meta.get('status')}")
        print(f"confirmed:  {meta.get('confirmed')}")
        print(f"persist:    {meta.get('persist_written')}")
        print(f"created:    {meta.get('created_at')}")
        print(f"timeout:    {meta.get('timeout_seconds')}s")
        print(f"watchdog:   {meta.get('watchdog')}")
        exists = link_exists(bridge)
        print(f"present:    {exists}")
        if exists:
            print(f"addresses:  {', '.join(cidr_of(a) for a in global_ipv4(bridge) + global_ipv6(bridge))}")
            print(f"members:    {output(['ls', str(sys_net(bridge) / 'brif')], check=False)}")
        print(f"session:    {session_dir(bridge)}")
        print()
    return rc


def cmd_detect(args: argparse.Namespace) -> int:
    uplink = args.uplink
    if not link_exists(uplink):
        raise BridgeError(f"Interface not found: {uplink}")
    backend = detect_backend(uplink)
    print(f"uplink:  {uplink}")
    print(f"backend: {backend_label(backend)}")
    print(f"mac:     {interface_mac(uplink)}")
    print(f"up:      {link_is_up(uplink)}")
    print(f"addrs:   {', '.join(cidr_of(a) for a in global_ipv4(uplink) + global_ipv6(uplink))}")
    defaults = default_routes_for(uplink)
    print(f"gateway: {defaults[0].get('gateway') if defaults else None}")
    master = is_enslaved(uplink)
    if master:
        print(f"master:  {master}")
    return 0


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="kvm-vm-bridge",
        description="Create a Linux bridge on a host uplink, with automatic rollback until confirmed.",
    )
    p.add_argument("--version", action="version", version=f"%(prog)s {VERSION}")
    sp = p.add_subparsers(dest="command", required=True)

    c = sp.add_parser("create", help="Create a bridge, move the uplink into it, and arm auto-rollback")
    c.add_argument("--uplink", required=True, help="Existing physical interface that holds the host address")
    c.add_argument("--bridge", default=DEFAULT_BRIDGE, help=f"Bridge name to create (default: {DEFAULT_BRIDGE})")
    c.add_argument("--timeout", type=int, default=DEFAULT_TIMEOUT,
                   help=f"Seconds to wait for confirm before rolling back (default: {DEFAULT_TIMEOUT})")
    c.add_argument("--dry-run", action="store_true", help="Print the plan and detected backend without changing anything")
    c.set_defaults(func=cmd_create)

    c = sp.add_parser("confirm", help="Keep the bridge and cancel auto-rollback; write persistent config")
    c.add_argument("--bridge", default=DEFAULT_BRIDGE)
    c.add_argument("--no-persist", action="store_true",
                   help="Cancel the timer but do not write ifupdown/NetworkManager/networkd configuration")
    c.set_defaults(func=cmd_confirm)

    c = sp.add_parser("rollback", help="Restore the snapshot and remove a kvm-vm-bridge bridge")
    c.add_argument("--bridge", default=DEFAULT_BRIDGE)
    c.add_argument("--yes", action="store_true", help="Required. Perform the rollback.")
    c.set_defaults(func=cmd_rollback)

    c = sp.add_parser("status", help="Show the session for one bridge, or all sessions")
    c.add_argument("--bridge", default=None)
    c.set_defaults(func=cmd_status)

    c = sp.add_parser("detect", help="Show which network backend would manage an uplink")
    c.add_argument("--uplink", required=True)
    c.set_defaults(func=cmd_detect)

    return p


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()
    try:
        return int(args.func(args) or 0)
    except BridgeError as exc:
        eprint(f"ERROR: {exc}")
        try:
            log(f"ERROR: {exc}")
        except Exception:
            pass
        return 1


if __name__ == "__main__":
    sys.exit(main())
