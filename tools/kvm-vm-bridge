#!/usr/bin/env python3
"""kvm-vm-bridge: create a Linux bridge on a host uplink with automatic rollback.

Designed for a single KVM host whose management address lives on the uplink
that must join the bridge.  A rollback timer is armed *before* any network
change.  If the operator does not confirm in time, or if the change severs
management access, the previous runtime configuration is restored.

Persistent configuration is written only at confirm time, so a reboot during
the trial window brings the host back on its previous ifupdown, systemd-networkd
or NetworkManager settings.

No third-party Python packages are required.
"""
from __future__ import annotations

import argparse
import datetime as dt
import json
import os
import shutil
import signal
import socket
import subprocess
import sys
import time
from pathlib import Path
from typing import Any, Dict, List, Optional, Tuple

VERSION = "1.0.0"
STATE_DIR = Path(os.environ.get("KVM_VM_BRIDGE_STATE_DIR", "/var/lib/kvm-vm-bridge"))
LOG_FILE = Path(os.environ.get("KVM_VM_BRIDGE_LOG", "/var/log/kvm-vm-bridge.log"))
DEFAULT_TIMEOUT = 120
DEFAULT_BRIDGE = "br0"
WATCHDOG_UNIT_PREFIX = "kvm-vm-bridge-rollback-"


def etc_path(*parts: str) -> Path:
    """Host configuration root. Tests set KVM_VM_BRIDGE_ETC to a temporary directory."""
    root = Path(os.environ.get("KVM_VM_BRIDGE_ETC", "/etc"))
    return root.joinpath(*parts) if parts else root


def sys_net(name: str = "") -> Path:
    """sysfs network class. Tests set KVM_VM_BRIDGE_SYS_NET to a temporary tree."""
    root = Path(os.environ.get("KVM_VM_BRIDGE_SYS_NET", "/sys/class/net"))
    return root / name if name else root


class BridgeError(RuntimeError):
    pass


def utc_now() -> str:
    return dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def eprint(*args: Any) -> None:
    print(*args, file=sys.stderr)


def log(msg: str) -> None:
    line = f"{utc_now()} {msg}"
    print(line)
    try:
        LOG_FILE.parent.mkdir(parents=True, exist_ok=True)
        with LOG_FILE.open("a", encoding="utf-8") as fh:
            fh.write(line + "\n")
    except OSError:
        pass


def run(cmd: List[str], *, check: bool = True, capture: bool = False,
        input_text: Optional[str] = None) -> subprocess.CompletedProcess:
    env = os.environ.copy()
    env["LC_ALL"] = "C"
    if capture:
        return subprocess.run(
            cmd, check=check, text=True, input=input_text,
            stdout=subprocess.PIPE, stderr=subprocess.PIPE, env=env,
        )
    return subprocess.run(cmd, check=check, text=True, input=input_text, env=env)


def output(cmd: List[str], *, check: bool = True) -> str:
    return run(cmd, check=check, capture=True).stdout.strip()


def which(name: str) -> Optional[str]:
    return shutil.which(name)


def require_root() -> None:
    if os.geteuid() != 0:
        raise BridgeError("kvm-vm-bridge must run as root")


def require_commands(names: List[str]) -> None:
    missing = [n for n in names if which(n) is None]
    if missing:
        raise BridgeError("Missing required command(s): " + ", ".join(missing))


def systemd_is_active(unit: str) -> bool:
    if which("systemctl") is None:
        return False
    p = run(["systemctl", "is-active", "--quiet", unit], check=False, capture=True)
    return p.returncode == 0


def service_enabled_or_active(unit: str) -> bool:
    if which("systemctl") is None:
        return False
    return (
        run(["systemctl", "is-active", "--quiet", unit], check=False, capture=True).returncode == 0
        or run(["systemctl", "is-enabled", "--quiet", unit], check=False, capture=True).returncode == 0
    )


def ip_json(args: List[str]) -> Any:
    raw = output(["ip", "-j"] + args, check=True)
    return json.loads(raw) if raw else []


def link_exists(name: str) -> bool:
    return sys_net(name).exists()


def link_is_up(name: str) -> bool:
    oper = sys_net(name) / "operstate"
    if not oper.exists():
        return False
    state = oper.read_text(encoding="utf-8").strip()
    if state in {"up", "unknown"}:
        return True
    # carrier may still be valid when operstate is "dormant"
    carrier = sys_net(name) / "carrier"
    try:
        return carrier.read_text(encoding="utf-8").strip() == "1"
    except OSError:
        return False


def link_info(name: str) -> Dict[str, Any]:
    data = ip_json(["-d", "link", "show", "dev", name])
    if not data:
        raise BridgeError(f"Interface not found: {name}")
    return data[0]


def is_bridge(name: str) -> bool:
    return (sys_net(name) / "bridge").exists()


def is_enslaved(name: str) -> Optional[str]:
    master = sys_net(name) / "master"
    if master.exists() or master.is_symlink():
        try:
            return Path(os.readlink(str(master))).name
        except OSError:
            return master.resolve().name
    info = link_info(name)
    return info.get("master")


def interface_mac(name: str) -> str:
    return (sys_net(name) / "address").read_text(encoding="utf-8").strip()


def interface_addrs(name: str) -> List[Dict[str, Any]]:
    data = ip_json(["addr", "show", "dev", name])
    if not data:
        return []
    return list(data[0].get("addr_info") or [])


def global_ipv4(name: str) -> List[Dict[str, Any]]:
    return [
        a for a in interface_addrs(name)
        if a.get("family") == "inet" and a.get("scope") == "global"
    ]


def global_ipv6(name: str) -> List[Dict[str, Any]]:
    return [
        a for a in interface_addrs(name)
        if a.get("family") == "inet6" and a.get("scope") == "global"
    ]


def default_routes_for(dev: str) -> List[Dict[str, Any]]:
    routes = ip_json(["route", "show", "default"])
    return [r for r in routes if r.get("dev") == dev]


def all_routes_for(dev: str) -> List[Dict[str, Any]]:
    routes = ip_json(["route", "show"])
    return [r for r in routes if r.get("dev") == dev]


# ---------------------------------------------------------------------------
# Backend detection
# ---------------------------------------------------------------------------

def nm_device_connection(uplink: str) -> Optional[str]:
    if which("nmcli") is None:
        return None
    p = run(
        ["nmcli", "-t", "-f", "GENERAL.CONNECTION", "device", "show", uplink],
        check=False, capture=True,
    )
    if p.returncode != 0:
        return None
    for line in p.stdout.splitlines():
        if ":" in line:
            value = line.split(":", 1)[1].strip()
            return value or None
    return None


def nm_device_managed(uplink: str) -> bool:
    if which("nmcli") is None:
        return False
    p = run(
        ["nmcli", "-t", "-f", "GENERAL.STATE", "device", "show", uplink],
        check=False, capture=True,
    )
    if p.returncode != 0:
        return False
    # "100 (connected)" etc. If NM knows the device at all, treat as managed
    # unless it says unmanaged.
    p2 = run(
        ["nmcli", "-t", "-f", "GENERAL.NM-MANAGED", "device", "show", uplink],
        check=False, capture=True,
    )
    text = (p2.stdout or "") + (p.stdout or "")
    if "unmanaged" in text.lower() or text.strip().endswith(":no"):
        return False
    return "GENERAL.NM-MANAGED:yes" in p2.stdout.replace(" ", "") or "connected" in p.stdout.lower() or bool(nm_device_connection(uplink))


def networkd_manages(uplink: str) -> bool:
    netdir = etc_path("systemd", "network")
    if not netdir.exists():
        return False
    for path in list(netdir.glob("*.network")):
        try:
            text = path.read_text(encoding="utf-8", errors="replace")
        except OSError:
            continue
        if uplink in text:
            return True
    if which("networkctl"):
        p = run(["networkctl", "status", uplink], check=False, capture=True)
        if p.returncode == 0 and "Network File:" in p.stdout:
            return True
    return False


def ifupdown_mentions(uplink: str) -> bool:
    paths = [etc_path("network", "interfaces")]
    extra = etc_path("network", "interfaces.d")
    if extra.is_dir():
        paths.extend(sorted(p for p in extra.iterdir() if p.is_file()))
    for path in paths:
        try:
            text = path.read_text(encoding="utf-8", errors="replace")
        except OSError:
            continue
        if uplink in text:
            return True
    return False


def detect_backend(uplink: str) -> str:
    """Return 'networkmanager', 'networkd', 'ifupdown', or 'runtime'."""
    nm_active = systemd_is_active("NetworkManager")
    networkd_active = systemd_is_active("systemd-networkd")
    networking_active = service_enabled_or_active("networking")

    if nm_active and nm_device_managed(uplink):
        return "networkmanager"
    if networkd_active and networkd_manages(uplink):
        return "networkd"
    if (networking_active or etc_path("network", "interfaces").exists()) and (
        ifupdown_mentions(uplink) or networking_active
    ):
        return "ifupdown"
    if nm_active:
        return "networkmanager"
    if networkd_active:
        return "networkd"
    if etc_path("network", "interfaces").exists():
        return "ifupdown"
    return "runtime"


def backend_label(backend: str) -> str:
    return {
        "networkmanager": "NetworkManager",
        "networkd": "systemd-networkd",
        "ifupdown": "ifupdown",
        "runtime": "runtime only (no persistent network manager detected)",
    }[backend]


# ---------------------------------------------------------------------------
# State
