def session_dir(bridge: str) -> Path:
    return STATE_DIR / "sessions" / bridge


def load_meta(bridge: str) -> Dict[str, Any]:
    path = session_dir(bridge) / "meta.json"
    if not path.exists():
        raise BridgeError(f"No kvm-vm-bridge session found for {bridge} under {STATE_DIR}")
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        raise BridgeError(f"Invalid session metadata {path}: {exc}") from exc


def save_json(path: Path, data: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(json.dumps(data, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    tmp.replace(path)


def copy_if_exists(src: Path, dest: Path) -> Optional[str]:
    if not src.exists():
        return None
    dest.parent.mkdir(parents=True, exist_ok=True)
    if src.is_dir():
        if dest.exists():
            shutil.rmtree(dest)
        shutil.copytree(src, dest)
        return str(dest)
    shutil.copy2(src, dest)
    return str(dest)


# ---------------------------------------------------------------------------
# Snapshot and generated rollback script
# ---------------------------------------------------------------------------

def snapshot_system(bridge: str, uplink: str, backend: str, timeout: int) -> Path:
    sdir = session_dir(bridge)
    if sdir.exists():
        raise BridgeError(
            f"A session for {bridge} already exists at {sdir}. "
            "Run 'kvm-vm-bridge status' and confirm or roll back first."
        )
    sdir.mkdir(parents=True, exist_ok=True)
    (sdir / "files").mkdir(exist_ok=True)

    addr = ip_json(["addr"])
    link = ip_json(["-d", "link"])
    route = ip_json(["route"])
    try:
        rule = ip_json(["rule"])
    except Exception:
        rule = []

    save_json(sdir / "ip-addr.json", addr)
    save_json(sdir / "ip-link.json", link)
    save_json(sdir / "ip-route.json", route)
    save_json(sdir / "ip-rule.json", rule)

    copied: Dict[str, str] = {}
    mapping = {
        "interfaces": etc_path("network", "interfaces"),
        "interfaces.d": etc_path("network", "interfaces.d"),
        "systemd-network": etc_path("systemd", "network"),
        "NetworkManager-system-connections": etc_path("NetworkManager", "system-connections"),
        "resolv.conf": etc_path("resolv.conf"),
    }
    for key, src in mapping.items():
        dest = sdir / "files" / key
        stored = copy_if_exists(src, dest)
        if stored:
            copied[key] = stored

    v4 = global_ipv4(uplink)
    v6 = global_ipv6(uplink)
    defaults = default_routes_for(uplink)
    gw = None
    if defaults:
        gw = defaults[0].get("gateway")

    meta = {
        "bridge": bridge,
        "uplink": uplink,
        "backend": backend,
        "timeout_seconds": timeout,
        "created_at": utc_now(),
        "hostname": socket.gethostname(),
        "uplink_mac": interface_mac(uplink),
        "ipv4": v4,
        "ipv6": v6,
        "default_routes": defaults,
        "gateway": gw,
        "copied_files": copied,
        "confirmed": False,
        "persist_written": False,
        "watchdog": None,
        "status": "snapshot",
    }
    save_json(sdir / "meta.json", meta)
    write_rollback_script(sdir, meta)
    write_archive_script(sdir)
    return sdir


def cidr_of(addr: Dict[str, Any]) -> str:
    return f"{addr['local']}/{addr['prefixlen']}"


def write_rollback_script(sdir: Path, meta: Dict[str, Any]) -> Path:
    """Write a bash script that can restore runtime networking without Python."""
    bridge = meta["bridge"]
    uplink = meta["uplink"]
    lines = [
        "#!/bin/bash",
        "# Generated by kvm-vm-bridge. Restores the pre-bridge runtime configuration.",
        "set -u",
        f"LOG={_shell_single(str(LOG_FILE))}",
        f"BRIDGE={_shell_single(bridge)}",
        f"UPLINK={_shell_single(uplink)}",
        "ts() { date -u +%Y-%m-%dT%H:%M:%SZ; }",
        'log() { echo "$(ts) rollback: $*" | tee -a "$LOG"; }',
        'log "starting rollback of $BRIDGE (uplink $UPLINK)"',
        "export LC_ALL=C",
        'if [[ -d /sys/class/net/$UPLINK ]]; then',
        '  ip link set "$UPLINK" nomaster 2>/dev/null || true',
        '  ip link set "$UPLINK" up || true',
        "fi",
        'if [[ -d /sys/class/net/$BRIDGE ]]; then',
        '  ip addr flush dev "$BRIDGE" 2>/dev/null || true',
        '  ip link set "$BRIDGE" down 2>/dev/null || true',
        '  ip link delete dev "$BRIDGE" type bridge 2>/dev/null || ip link delete dev "$BRIDGE" 2>/dev/null || true',
        "fi",
    ]
    # Restore IPv4/IPv6 that were on the uplink. Flush first to drop leftovers.
    lines.append('if [[ -d /sys/class/net/$UPLINK ]]; then')
    lines.append('  ip addr flush dev "$UPLINK" || true')
    for addr in meta.get("ipv4") or []:
        lines.append(f'  ip addr add {_shell_single(cidr_of(addr))} dev "$UPLINK" || true')
        if addr.get("broadcast"):
            # broadcast is set automatically from prefix in most cases
            pass
    for addr in meta.get("ipv6") or []:
        lines.append(f'  ip -6 addr add {_shell_single(cidr_of(addr))} dev "$UPLINK" || true')
    lines.append("fi")

    # Restore routes that used the uplink. Default first, then others from snapshot file.
    lines.append(f"ROUTE_JSON={_shell_single(str(sdir / 'ip-route.json'))}")
    lines += [
        'if command -v python3 >/dev/null 2>&1 && [[ -f $ROUTE_JSON ]]; then',
        "  python3 - \"$UPLINK\" \"$ROUTE_JSON\" <<'PY'",
        "import json, sys, subprocess",
        "uplink, path = sys.argv[1], sys.argv[2]",
        "routes = json.loads(open(path, encoding='utf-8').read())",
        # defaults first
        "def key(r):",
        "    dst = r.get('dst') or ''",
        "    return (0 if dst == 'default' else 1, dst)",
        "for r in sorted(routes, key=key):",
        "    if r.get('dev') != uplink:",
        "        continue",
        "    if r.get('type') in ('anycast', 'broadcast', 'local', 'nat', 'throw', 'unreachable', 'prohibit', 'blackhole'):",
        "        continue",
        "    if r.get('protocol') == 'kernel' and r.get('dst') not in (None, 'default'):",
        "        # kernel connected routes return when the address is added",
        "        if r.get('dst') != 'default':",
        "            continue",
        "    cmd = ['ip']",
        "    if r.get('family') == 'inet6':",
        "        cmd.append('-6')",
        "    cmd.append('route')",
        "    cmd.append('replace')",
        "    dst = r.get('dst') or 'default'",
        "    cmd.append(dst)",
        "    if r.get('gateway'):",
        "        cmd += ['via', r['gateway']]",
        "    cmd += ['dev', uplink]",
        "    if r.get('metric') is not None:",
        "        cmd += ['metric', str(r['metric'])]",
        "    if r.get('onlink') or (isinstance(r.get('flags'), list) and 'onlink' in r['flags']):",
        "        cmd.append('onlink')",
        "    subprocess.run(cmd, check=False)",
        "PY",
        "fi",
    ]
    # Fallback default route if python is unavailable
    gw = meta.get("gateway")
    if gw:
        onlink = ""
        for r in meta.get("default_routes") or []:
            flags = r.get("flags") or []
            if r.get("onlink") or "onlink" in flags:
                onlink = " onlink"
                break
        lines.append(f'ip route replace default via {_shell_single(str(gw))} dev "$UPLINK"{onlink} || true')

    lines += [
        'log "runtime rollback finished"',
        'ip -br addr',
        'ip route show',
    ]
    path = sdir / "rollback.sh"
    path.write_text("\n".join(lines) + "\n", encoding="utf-8")
    path.chmod(0o750)
    return path


def _shell_single(value: str) -> str:
    return "'" + value.replace("'", "'\"'\"'") + "'"


def write_archive_script(sdir: Path) -> Path:
    """Archive the session after a successful rollback.

    The auto-rollback watchdog must do this itself. Calling
    ``kvm-vm-bridge rollback`` from inside the watchdog unit would stop that
    same unit and could kill the rollback before the session is archived.
    An explicit ``rollback --yes`` still archives in Python; this script is
    the path the watchdog uses. A failed create runs rollback.sh only and
    then moves the session to failed/, so it does not call this script.
    """
    bridge = sdir.name
    lines = [
        "#!/bin/bash",
        "# Generated by kvm-vm-bridge. Archives this session after rollback.sh succeeds.",
        "set -u",
        f"LOG={_shell_single(str(LOG_FILE))}",
        f"SESSION={_shell_single(str(sdir))}",
        f"STATE={_shell_single(str(STATE_DIR))}",
        f"BRIDGE={_shell_single(bridge)}",
        "ts() { date -u +%Y-%m-%dT%H:%M:%SZ; }",
        'log() { echo "$(ts) rollback: $*" | tee -a "$LOG"; }',
        'if [[ ! -d "$SESSION" ]]; then',
        '  log "session already archived"',
        "  exit 0",
        "fi",
        'if ! python3 - "$SESSION" <<\'PY\'',
        "import json, sys",
        "from datetime import datetime, timezone",
        "from pathlib import Path",
        "session = Path(sys.argv[1])",
        "meta_path = session / 'meta.json'",
        "if meta_path.is_file():",
        "    meta = json.loads(meta_path.read_text(encoding='utf-8'))",
        "    meta['status'] = 'rolled-back'",
        "    meta['rolled_back_at'] = datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')",
        "    meta['confirmed'] = False",
        "    meta_path.write_text(json.dumps(meta, indent=2, sort_keys=True) + '\\n', encoding='utf-8')",
        "PY",
        "then",
        '  log "could not update session metadata; leaving the session in place"',
        "  exit 1",
        "fi",
        'stamp="$(date -u +%Y%m%dT%H%M%S)"',
        'dest="$STATE/archived/${BRIDGE}-${stamp}"',
        'mkdir -p "$STATE/archived"',
        'if [[ -e "$dest" ]]; then dest="${dest}-$$"; fi',
        'mv "$SESSION" "$dest"',
        'log "archived session to $dest"',
        "exit 0",
    ]
    path = sdir / "archive.sh"
    path.write_text("\n".join(lines) + "\n", encoding="utf-8")
    path.chmod(0o750)
    return path


# ---------------------------------------------------------------------------
# Watchdog
# ---------------------------------------------------------------------------

def watchdog_unit(bridge: str) -> str:
    return f"{WATCHDOG_UNIT_PREFIX}{bridge}.service"


def arm_watchdog(bridge: str, timeout: int, sdir: Path) -> Dict[str, Any]:
    rollback = sdir / "rollback.sh"
    if timeout <= 0:
        raise BridgeError("--timeout must be a positive number of seconds")
    info: Dict[str, Any] = {"method": None, "timeout": timeout}

    if which("systemd-run") and which("systemctl"):
        unit = watchdog_unit(bridge)
        run(["systemctl", "stop", unit], check=False, capture=True)
        run(["systemctl", "reset-failed", unit], check=False, capture=True)
        # A transient service that waits, then rolls back unless a stamp exists.
        script = sdir / "watchdog.sh"
        confirmed = sdir / "CONFIRMED"
        archive = write_archive_script(sdir)
        # Do not exec rollback.sh: the process must continue and archive the
        # session, or the next create is blocked by the leftover directory.
        script.write_text(
            "\n".join([
                "#!/bin/bash",
                "set -u",
                f"sleep {int(timeout)}",
                f"if [[ -f {_shell_single(str(confirmed))} ]]; then",
                "  exit 0",
                "fi",
                f"/bin/bash {_shell_single(str(rollback))}",
                "rc=$?",
                "if [[ $rc -ne 0 ]]; then",
                "  exit $rc",
                "fi",
                f"exec /bin/bash {_shell_single(str(archive))}",
            ]) + "\n",
            encoding="utf-8",
        )
        script.chmod(0o750)
        # --remain-after-exit is a flag with no argument. Passing "=no" makes
        # systemd-run reject the command on current systemd (Debian 13 / EL9).
        p = run(
            [
                "systemd-run",
                f"--unit={unit}",
                f"--description=kvm-vm-bridge auto-rollback for {bridge}",
                "--collect",
                "--no-block",
                "--service-type=oneshot",
                "/bin/bash", str(script),
            ],
            check=False, capture=True,
        )
        if p.returncode == 0:
            info["method"] = "systemd-run"
            info["unit"] = unit
            log(f"armed systemd watchdog {unit} for {timeout}s")
            return info
        log(f"systemd-run failed ({p.stderr.strip() or p.stdout.strip()}); falling back to a background process")

    # Fallback: detached process, immune to the calling SSH session.
    confirmed = sdir / "CONFIRMED"
    pid_path = sdir / "watchdog.pid"
    archive = write_archive_script(sdir)
    # setsid starts a new session so the timer is not in the caller's process
    # group (SSH SIGHUP). A parent systemd unit with KillMode=control-group
    # can still reap it, which is why systemd-run is preferred.
    # Archive only after rollback.sh succeeds, matching the systemd watchdog.
    inner = (
        f"sleep {int(timeout)}; "
        f"if [ ! -f {confirmed} ]; then "
        f"/bin/bash {rollback} && /bin/bash {archive}; "
        f"fi"
    )
    cmd = (
        f"setsid -f nohup /bin/bash -c {_shell_single(inner)}"
        f" </dev/null >>{_shell_single(str(LOG_FILE))} 2>&1 & echo $!"
    )
    p = run(["bash", "-lc", cmd], check=True, capture=True)
    pid = p.stdout.strip().splitlines()[-1].strip()
    pid_path.write_text(pid + "\n", encoding="utf-8")
    info["method"] = "nohup"
    info["pid"] = int(pid)
    log(f"armed nohup watchdog pid={pid} for {timeout}s")
    return info


def cancel_watchdog(meta: Dict[str, Any]) -> None:
    wd = meta.get("watchdog") or {}
    if wd.get("method") == "systemd-run" and wd.get("unit"):
        run(["systemctl", "stop", wd["unit"]], check=False, capture=True)
        run(["systemctl", "reset-failed", wd["unit"]], check=False, capture=True)
        log(f"stopped systemd watchdog {wd['unit']}")
    if wd.get("method") == "nohup" and wd.get("pid"):
        pid = int(wd["pid"])
        try:
            os.kill(pid, signal.SIGTERM)
            log(f"sent SIGTERM to watchdog pid={pid}")
        except ProcessLookupError:
            pass
    # Also stop any leftover unit with the well-known name
    if which("systemctl"):
        run(["systemctl", "stop", watchdog_unit(meta["bridge"])], check=False, capture=True)


# ---------------------------------------------------------------------------
# Runtime apply
# ---------------------------------------------------------------------------

def apply_runtime(bridge: str, uplink: str, meta: Dict[str, Any]) -> None:
    mac = meta["uplink_mac"]
    v4 = meta.get("ipv4") or []
    v6 = meta.get("ipv6") or []
    if not v4 and not v6:
        raise BridgeError(f"Uplink {uplink} has no global IPv4 or IPv6 address to migrate")

    log(f"creating bridge {bridge} (stp off, forward_delay 0, mac={mac})")
    run(["ip", "link", "add", "name", bridge, "type", "bridge", "stp_state", "0", "forward_delay", "0"])
    # Some iproute2 versions want a second call for attributes
    run(["ip", "link", "set", "dev", bridge, "type", "bridge", "stp_state", "0", "forward_delay", "0"], check=False)
    run(["ip", "link", "set", "dev", bridge, "address", mac], check=False)
    run(["ip", "link", "set", "dev", bridge, "up"])

    log(f"moving addresses from {uplink} to {bridge}")
    for addr in v4:
        run(["ip", "addr", "add", cidr_of(addr), "dev", bridge], check=False)
    for addr in v6:
        run(["ip", "-6", "addr", "add", cidr_of(addr), "dev", bridge], check=False)

    log(f"enslaving {uplink} to {bridge}")
    run(["ip", "link", "set", "dev", uplink, "master", bridge])
    # Keep the uplink up; addresses on the slave are ignored for routing
    for addr in v4:
        run(["ip", "addr", "del", cidr_of(addr), "dev", uplink], check=False)
    for addr in v6:
        run(["ip", "-6", "addr", "del", cidr_of(addr), "dev", uplink], check=False)

    log("installing routes on the bridge")
    # Connected routes appear from the addresses. Replace default and host routes.
    for r in meta.get("default_routes") or []:
        cmd = ["ip"]
        if r.get("family") == "inet6":
            cmd.append("-6")
        cmd += ["route", "replace", "default"]
        if r.get("gateway"):
            cmd += ["via", str(r["gateway"])]
        cmd += ["dev", bridge]
        if r.get("metric") is not None:
            cmd += ["metric", str(r["metric"])]
        flags = r.get("flags") or []
        if r.get("onlink") or "onlink" in flags:
            cmd.append("onlink")
        run(cmd, check=False)

    # Re-home non-kernel unicast routes that pointed at the uplink
    try:
        routes = json.loads((session_dir(bridge) / "ip-route.json").read_text(encoding="utf-8"))
    except Exception:
        routes = []
    for r in routes:
        if r.get("dev") != uplink:
            continue
        dst = r.get("dst") or "default"
        if dst == "default":
            continue
        if r.get("protocol") == "kernel":
            continue
        if r.get("type") and r.get("type") != "unicast":
            continue
        cmd = ["ip"]
        if r.get("family") == "inet6":
            cmd.append("-6")
        cmd += ["route", "replace", dst]
        if r.get("gateway"):
            cmd += ["via", str(r["gateway"])]
        cmd += ["dev", bridge]
        if r.get("metric") is not None:
            cmd += ["metric", str(r["metric"])]
        run(cmd, check=False)


def verify_runtime(bridge: str, uplink: str, meta: Dict[str, Any]) -> None:
    if not is_bridge(bridge):
        raise BridgeError(f"Bridge {bridge} was not created")
    master = is_enslaved(uplink)
    if master != bridge:
        raise BridgeError(f"Uplink {uplink} is not enslaved to {bridge} (master={master})")
    if not global_ipv4(bridge) and not global_ipv6(bridge):
        raise BridgeError(f"Bridge {bridge} has no global address")
    defaults = ip_json(["route", "show", "default"])
    if not any(r.get("dev") == bridge for r in defaults):
        raise BridgeError(f"Default route is not on {bridge}: {defaults}")
    gw = meta.get("gateway")
    if gw:
        p = run(["ping", "-c", "1", "-W", "3", str(gw)], check=False, capture=True)
        if p.returncode != 0:
            raise BridgeError(f"Gateway {gw} did not answer ping after the change")
        log(f"gateway {gw} is reachable")


